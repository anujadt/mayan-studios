---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Gallery from '../components/Gallery.astro';
import RevenueChart from '../components/RevenueChart.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import QuickContact from '../components/QuickContact.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { studio2Gallery, revenueStats, whatsappURL } from '../data/properties';

const interior = [
  { icon: 'check', text: 'Fully Furnished & Move-In Ready' },
  { icon: 'light', text: 'Corner Unit with Enhanced Natural Light' },
  { icon: 'bed', text: 'Comfortable Sleeping Area with Quality Bedding' },
  { icon: 'sofa', text: 'Stylish Living Area with Sofa, Smart TV & Dining' },
  { icon: 'check', text: 'Fully Equipped Kitchen (Oven, Microwave, Washing Machine, Coffee Maker)' },
  { icon: 'bath', text: 'Premium Bathroom with Designer Fixtures & Rain Shower' },
  { icon: 'view', text: 'Spacious Private Balcony with Sea & Community Views' },
  { icon: 'ac', text: 'Centralised Air Conditioning' },
  { icon: 'check', text: 'Built-in Wardrobe' },
];

const building = [
  { icon: 'concierge', text: '24/7 Concierge & Security' },
  { icon: 'gym', text: 'Fully-Equipped Gym (Cybex)' },
  { icon: 'pool', text: 'Infinity Pool & Children\'s Pools' },
  { icon: 'garden', text: 'Indoor & Outdoor Children\'s Playgrounds' },
  { icon: 'bbq', text: 'Barbecue Areas & Sun Decks' },
  { icon: 'beach', text: 'Direct Private Beach Access' },
  { icon: 'parking', text: 'Underground Covered Parking' },
  { icon: 'sauna', text: 'Sauna & Steam Rooms' },
];

const nearby = [
  { place: 'Private Beach & Yas Links Golf', time: '1 min' },
  { place: 'Yas Bay Restaurants', time: '3 min' },
  { place: 'Yas Marina Circuit (F1)', time: '7 min' },
  { place: 'Ferrari World & Yas Waterworld', time: '7 min' },
  { place: 'Yas Mall (Shopping & Cinemas)', time: '9 min' },
  { place: 'Zayed International Airport', time: '10 min' },
  { place: 'Downtown Abu Dhabi', time: '25 min' },
  { place: 'Dubai', time: '50 min' },
];

const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Apartment',
  name: 'Furnished Corner Studio · Mayan 2 · 2nd Floor · Yas Island',
  description: 'A fully furnished corner studio at Mayan 2, Yas Island, Abu Dhabi. 2nd floor, ~550 sqft, private balcony with sea view, designer bathroom, fully-equipped kitchen, and access to private beach, infinity pool, gym, sauna. Rated 8.5 on Booking.com with documented AED 148K annual revenue.',
  numberOfRooms: 1,
  floorSize: { '@type': 'QuantitativeValue', value: 550, unitCode: 'FTK' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mayan 2, Yas Island',
    addressLocality: 'Abu Dhabi',
    addressCountry: 'AE',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '8.5',
    ratingCount: '167',
    bestRating: '10',
    reviewCount: '167',
  },
  amenityFeature: building.map((b) => ({ '@type': 'LocationFeatureSpecification', name: b.text })),
};
---
<Layout
  title="Furnished Corner Studio · Mayan 2 · For Sale · AED 148K Revenue · 8.5★"
  description="Fully furnished corner studio for sale at Mayan 2, Yas Island. 2nd floor, ~550 sqft, sea-view balcony. AED 148K annual revenue documented on Booking.com (8.5★ · 69% occupancy). Turnkey luxury investment."
  ogImage="/images/studio-2f/01-bedroom-living.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(listingSchema)} />

  <!-- Top hero with title overlay -->
  <section class="listing-hero">
    <div class="hero-image" style="background-image: url('/images/studio-2f/01-bedroom-living.jpg')"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <a href="/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Back to Listings</span>
      </a>
      <div class="status-pill">
        <span class="dot"></span>
        <span>For Sale · Furnished · Move-In Ready</span>
      </div>
      <h1>Furnished Corner Studio</h1>
      <div class="hero-sub">Mayan 2 · 2nd Floor · Yas Island · Abu Dhabi</div>
      <div class="hero-rating-row">
        <span class="rating-pill"><Icon name="star" size={14} /> <strong>8.5</strong> · Booking.com</span>
        <span class="rating-pill revenue"><strong>AED 148K</strong> · Annual Revenue</span>
      </div>
    </div>
  </section>

  <!-- Specs bar -->
  <section class="specs">
    <div class="container specs-inner">
      <div class="spec"><Icon name="bed" size={20} /><div><span class="spec-num">Studio</span><span class="spec-label">Layout</span></div></div>
      <div class="spec"><Icon name="bath" size={20} /><div><span class="spec-num">1 Bath</span><span class="spec-label">Designer Fixtures</span></div></div>
      <div class="spec"><Icon name="area" size={20} /><div><span class="spec-num">~550 sqft</span><span class="spec-label">Floor Area</span></div></div>
      <div class="spec"><Icon name="floor" size={20} /><div><span class="spec-num">2nd Floor</span><span class="spec-label">Corner Unit</span></div></div>
      <div class="spec"><Icon name="check" size={20} /><div><span class="spec-num">Furnished</span><span class="spec-label">For Sale</span></div></div>
    </div>
  </section>

  <!-- INVESTMENT PERFORMANCE -->
  <section id="revenue" class="section revenue-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow gold-on-dark">Investment Performance</span>
        <h2 class="white-h">Documented revenue. Verified by extranet.</h2>
        <div class="gold-divider center"></div>
        <p class="rev-intro">
          Operating revenue from the past twelve months on Booking.com — the studio has hosted {revenueStats.reservations} reservations at a {revenueStats.occupancy}% booking rate. Available for full verification during due diligence.
        </p>
      </div>

      <div class="rev-stats fade-in">
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.annualisedLabel}</div>
          <div class="rev-lbl">Annual Revenue</div>
        </div>
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.reservations}</div>
          <div class="rev-lbl">Reservations</div>
        </div>
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.occupancy}%</div>
          <div class="rev-lbl">Occupancy</div>
        </div>
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.guestRating}/5</div>
          <div class="rev-lbl">Guest Rating</div>
        </div>
      </div>

      <div class="rev-chart-card fade-in">
        <div class="rev-chart-head">
          <div>
            <div class="rev-chart-eyebrow">Monthly Revenue · Apr 2025 – Mar 2026</div>
            <div class="rev-chart-title">Gross revenue before platform commissions and operating costs.</div>
          </div>
          <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener" class="rev-source">View on Booking.com →</a>
        </div>
        <RevenueChart />
        <div class="rev-chart-foot">
          <div><strong>Average monthly:</strong> {revenueStats.averageMonthlyLabel}</div>
          <div><strong>Peak month (December):</strong> {revenueStats.peakMonthlyLabel}</div>
          <div class="rev-source-note">Revenue data from Booking.com extranet. Available for verification during due diligence.</div>
        </div>
      </div>

      <p class="rev-disclaimer fade-in">
        Past performance is shown gross, before platform commissions, cleaning, utilities and other operating costs. Future revenue depends on market conditions, pricing strategy, and operator. The studio is also fully suitable for owner occupation.
      </p>
    </div>
  </section>

  <!-- QUICK CONTACT (after emotional peak) -->
  <QuickContact />

  <!-- Booking.com review/badge -->
  <section class="section booking-review">
    <div class="container-narrow review-inner">
      <div class="review-card fade-in">
        <div class="review-rating">
          <div class="rating-num">8.5</div>
          <div class="rating-meta">
            <div class="rating-label">Booking.com</div>
            <div class="rating-stars" aria-hidden="true"><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /></div>
          </div>
        </div>
        <blockquote>
          "Perfect luxury stay with excellent value for money. Prime location near Yas Beach, F1 Circuit, Ferrari World. Spotlessly clean, well-equipped, exceptional facilities."
        </blockquote>
        <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener" class="review-link">View the listing on Booking.com →</a>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="container-narrow gallery-wrap">
    <Gallery images={studio2Gallery} />
  </section>

  <!-- Description -->
  <section class="section description-section">
    <div class="container-narrow">
      <div class="fade-in">
        <span class="eyebrow">The Residence</span>
        <h2>Turnkey Luxury · Furnished &amp; Move-In Ready</h2>
        <div class="gold-divider"></div>
        <div class="prose">
          <p class="lead">
            A beautifully furnished corner studio at Mayan 2 — refined, low-maintenance, and steps from the Arabian Gulf. Rated 8.5 on Booking.com by 167 guests across a documented two-year operating history.
          </p>
          <p>
            As a corner unit on the 2nd floor, it benefits from enhanced natural light and twin-balcony exposures, with views of both the Arabian Gulf and the resort-style Mayan community gardens. Move-in ready as a home, or guest-ready from day one as a short-stay investment.
          </p>
          <p>
            Within easy reach of Yas Marina Circuit, Ferrari World, Yas Waterworld, and Yas Mall — and minutes from Zayed International Airport.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section features-section">
    <div class="container">
      <div class="features-grid">
        <div class="features-col fade-in">
          <span class="eyebrow">Interior</span>
          <h3>Studio Features</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {interior.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="features-col fade-in">
          <span class="eyebrow">Building</span>
          <h3>Facilities &amp; Amenities</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {building.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section compare-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Building Context</span>
        <h2>The Other Studio in This Building</h2>
        <div class="gold-divider center"></div>
        <p class="compare-intro">Another unit in this building was recently taken off market. Here's how the two compare — different floor, different layout, different proposition.</p>
      </div>
      <div class="fade-in">
        <ComparisonTable />
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section location-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Location</span>
        <h2>Yas Island — at the centre of it all.</h2>
        <div class="gold-divider center"></div>
      </div>

      <div class="location-grid">
        <div class="location-map fade-in">
          <iframe
            src="https://www.google.com/maps?q=Mayan+2+Yas+Island+Abu+Dhabi&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map of Mayan 2, Yas Island"
            allowfullscreen
          ></iframe>
        </div>
        <div class="nearby-list fade-in">
          <h3>Nearby</h3>
          <div class="gold-divider"></div>
          {nearby.map((n) => (
            <div class="nearby-row">
              <span class="nearby-place">{n.place}</span>
              <span class="nearby-dots"></span>
              <span class="nearby-time">{n.time}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="neighbourhood-grid fade-in">
        <figure>
          <img src="/images/amenities/beach-watersports.jpg" alt="Private beach with watersports equipment" loading="lazy" />
          <figcaption>Private beach · 1 min</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/beach-panoramic.jpg" alt="Panoramic beach view with sun loungers" loading="lazy" />
          <figcaption>Yas Beach · 1 min</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/beach-water.jpg" alt="Beach view with Mayan building" loading="lazy" />
          <figcaption>Mayan 2 · Beachfront</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-text fade-in">
          <span class="eyebrow gold-on-dark">Inquiries</span>
          <h2 class="white-h">Schedule a Private Viewing</h2>
          <div class="gold-divider"></div>
          <p class="muted-on-dark">
            The studio is furnished, move-in ready, and privately offered for sale. Share a few details and the owner will follow up personally — or message directly on WhatsApp for the fastest response.
          </p>
          <div class="contact-meta">
            <div>
              <h5>WhatsApp</h5>
              <a class="wa-link" href={whatsappURL} target="_blank" rel="noopener">
                <Icon name="whatsapp" size={18} /> +971 54 702 6170
              </a>
            </div>
            <div>
              <h5>Booking.com</h5>
              <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener">View the 8.5★ listing →</a>
            </div>
            <div>
              <h5>Property Brief</h5>
              <a href="/mayan-2f-brief.html" target="_blank" rel="noopener">Download one-pager →</a>
            </div>
            <div>
              <h5>Location</h5>
              <span>Mayan 2 · Yas Island · Abu Dhabi</span>
            </div>
          </div>
        </div>
        <div class="contact-form-wrap fade-in">
          <InquiryForm property="Furnished Corner Studio · Mayan 2 · 2F" variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <StickyCTA />
</Layout>

<style>
  .listing-hero {
    position: relative;
    height: 80vh;
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,25,59,0.35) 0%, rgba(17,25,59,0.15) 35%, rgba(17,25,59,0.85) 100%);
  }
  .listing-hero .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 4rem;
    padding-top: 8rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin-bottom: 1.5rem;
  }
  .back-link:hover { color: var(--gold); }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.25);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }
  .status-pill .dot {
    width: 8px;
    height: 8px;
    background: #4ADE80;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(74,222,128,0.25);
  }
  .listing-hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.0;
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: rgba(255,255,255,0.85);
    margin-bottom: 1.25rem;
  }
  .hero-rating-row { display: inline-flex; flex-wrap: wrap; gap: 0.5rem; }
  .rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--gold);
    color: var(--navy);
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .rating-pill.revenue {
    background: rgba(11,17,36,0.9);
    color: var(--gold-light);
    border: 1px solid var(--gold);
  }
  .rating-pill strong { font-weight: 700; }

  /* Specs */
  .specs {
    background: var(--white);
    border-bottom: 1px solid var(--gray-warm);
    padding: 2rem 0;
  }
  .specs-inner {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }
  .spec {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--gold);
  }
  .spec > div { display: flex; flex-direction: column; line-height: 1.2; }
  .spec-num {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--navy);
  }
  .spec-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .specs-inner { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 480px) {
    .specs-inner { grid-template-columns: 1fr; }
  }

  /* REVENUE SECTION */
  .revenue-section {
    background: linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 100%);
    color: var(--white);
  }
  .revenue-section .section-header { margin-bottom: 3rem; }
  .revenue-section .gold-divider.center { margin: 1.5rem auto; }
  .gold-on-dark { color: var(--gold-light); }
  .white-h { color: var(--white); }
  .rev-intro {
    max-width: 640px;
    margin: 1.25rem auto 0;
    color: rgba(255,255,255,0.78);
    font-size: 1rem;
    line-height: 1.7;
  }
  .rev-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-bottom: 3rem;
    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  @media (max-width: 768px) {
    .rev-stats { grid-template-columns: repeat(2, 1fr); }
  }
  .rev-stat {
    padding: 1.75rem 1rem;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.08);
  }
  .rev-stat:last-child { border-right: none; }
  @media (max-width: 768px) {
    .rev-stat:nth-child(2n) { border-right: none; }
    .rev-stat:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.08); }
  }
  .rev-num {
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    color: var(--gold-light);
    font-weight: 600;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .rev-lbl {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }
  .rev-chart-card {
    background: var(--white);
    padding: 2.25rem;
    margin-bottom: 2rem;
  }
  @media (max-width: 600px) { .rev-chart-card { padding: 1.5rem 1rem; } }
  .rev-chart-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .rev-chart-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.35rem;
  }
  .rev-chart-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--navy);
    line-height: 1.4;
    max-width: 540px;
  }
  .rev-source {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    flex-shrink: 0;
  }
  .rev-chart-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gray-warm);
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .rev-chart-foot strong { color: var(--navy); font-weight: 600; }
  .rev-source-note {
    flex-basis: 100%;
    font-size: 0.78rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .rev-disclaimer {
    font-size: 0.82rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .gallery-wrap { padding-top: 3rem; padding-bottom: 2rem; }

  /* Booking review card */
  .booking-review { background: var(--ivory); padding: 4rem 0; }
  .review-inner { display: flex; justify-content: center; }
  .review-card {
    background: var(--white);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
    max-width: 720px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    border-top: 3px solid var(--gold);
  }
  .review-rating { display: flex; align-items: center; gap: 1rem; }
  .rating-num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
  }
  .rating-meta { text-align: left; }
  .rating-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .rating-stars { color: var(--gold); display: flex; gap: 1px; margin-top: 4px; }
  .review-card blockquote {
    font-family: var(--font-serif);
    font-style: italic;
