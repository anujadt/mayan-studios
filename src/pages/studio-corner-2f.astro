---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Gallery from '../components/Gallery.astro';
import { studio2Gallery } from '../data/properties';

const interior = [
  { icon: 'check', text: 'Fully Furnished & Move-In Ready' },
  { icon: 'light', text: 'Corner Unit with Enhanced Natural Light' },
  { icon: 'bed', text: 'Comfortable Sleeping Area with Quality Bedding' },
  { icon: 'sofa', text: 'Stylish Living Area with Sofa, Smart TV & Dining' },
  { icon: 'check', text: 'Fully Equipped Kitchen (Oven, Microwave, Washing Machine, Coffee Maker)' },
  { icon: 'bath', text: 'Premium Bathroom with Designer Fixtures & Rain Shower' },
  { icon: 'view', text: 'Spacious Private Balcony with Sea & Community Views' },
  { icon: 'ac', text: 'Centralised Air Conditioning' },
  { icon: 'check', text: 'Built-in Wardrobe' },
];

const building = [
  { icon: 'concierge', text: '24/7 Concierge & Security' },
  { icon: 'gym', text: 'Fully-Equipped Gym' },
  { icon: 'pool', text: 'Infinity Pool & Children\'s Pools' },
  { icon: 'garden', text: 'Indoor & Outdoor Children\'s Playgrounds' },
  { icon: 'bbq', text: 'Barbecue Areas' },
  { icon: 'beach', text: 'Direct Private Beach Access' },
  { icon: 'parking', text: 'Underground Covered Parking' },
  { icon: 'sauna', text: 'Sauna & Steam Rooms' },
];

const nearby = [
  { place: 'Private Beach & Yas Links Golf', time: '1 min' },
  { place: 'Yas Bay Restaurants', time: '3 min' },
  { place: 'Yas Marina Circuit (F1)', time: '7 min' },
  { place: 'Ferrari World & Yas Waterworld', time: '7 min' },
  { place: 'Yas Mall (Shopping & Cinemas)', time: '9 min' },
  { place: 'Zayed International Airport', time: '10 min' },
  { place: 'Downtown Abu Dhabi', time: '25 min' },
  { place: 'Dubai', time: '50 min' },
];

const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Apartment',
  name: 'Furnished Corner Studio · Mayan 2 · 2nd Floor · Yas Island',
  description: 'A fully furnished corner studio at Mayan 2, Yas Island, Abu Dhabi. 2nd floor, ~550 sqft, private balcony with sea view, designer bathroom, fully-equipped kitchen, and access to private beach, infinity pool, gym, sauna. Rated 8.5 on Booking.com.',
  numberOfRooms: 1,
  floorSize: { '@type': 'QuantitativeValue', value: 550, unitCode: 'FTK' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mayan 2, Yas Island',
    addressLocality: 'Abu Dhabi',
    addressCountry: 'AE',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '8.5',
    ratingCount: '1',
    bestRating: '10',
    reviewCount: '1',
  },
  amenityFeature: building.map((b) => ({ '@type': 'LocationFeatureSpecification', name: b.text })),
};
---
<Layout
  title="Furnished Corner Studio · Mayan 2 · 2F · For Sale · 8.5★ Booking.com"
  description="Fully furnished corner studio for sale at Mayan 2, Yas Island. 2nd floor, ~550 sqft, sea-view balcony, designer interiors, 8.5★ Booking.com rated. Turnkey luxury on Yas Island."
  ogImage="/images/studio-2f/01-bedroom-living.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(listingSchema)} />

  <!-- Top hero with title overlay -->
  <section class="listing-hero">
    <div class="hero-image" style="background-image: url('/images/studio-2f/01-bedroom-living.jpg')"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <a href="/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Back to Listings</span>
      </a>
      <div class="status-pill">
        <span class="dot"></span>
        <span>For Sale · Furnished · Move-In Ready</span>
      </div>
      <h1>Furnished Corner Studio</h1>
      <div class="hero-sub">Mayan 2 · 2nd Floor · Yas Island · Abu Dhabi</div>
      <div class="hero-rating">
        <span class="rating-pill"><Icon name="star" size={14} /> <strong>8.5</strong> · Rated on Booking.com</span>
      </div>
    </div>
  </section>

  <!-- Specs bar -->
  <section class="specs">
    <div class="container specs-inner">
      <div class="spec"><Icon name="bed" size={20} /><div><span class="spec-num">Studio</span><span class="spec-label">Layout</span></div></div>
      <div class="spec"><Icon name="bath" size={20} /><div><span class="spec-num">1 Bath</span><span class="spec-label">Designer Fixtures</span></div></div>
      <div class="spec"><Icon name="area" size={20} /><div><span class="spec-num">~550 sqft</span><span class="spec-label">Floor Area</span></div></div>
      <div class="spec"><Icon name="floor" size={20} /><div><span class="spec-num">2nd Floor</span><span class="spec-label">Corner Unit</span></div></div>
      <div class="spec"><Icon name="check" size={20} /><div><span class="spec-num">Furnished</span><span class="spec-label">For Sale</span></div></div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="container-narrow gallery-wrap">
    <Gallery images={studio2Gallery} />
  </section>

  <!-- Booking.com review/badge -->
  <section class="section booking-review">
    <div class="container-narrow review-inner">
      <div class="review-card fade-in">
        <div class="review-rating">
          <div class="rating-num">8.5</div>
          <div class="rating-meta">
            <div class="rating-label">Booking.com</div>
            <div class="rating-stars" aria-hidden="true"><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /></div>
          </div>
        </div>
        <blockquote>
          "Perfect luxury stay with excellent value for money. Prime location near Yas Beach, F1 Circuit, Ferrari World. Spotlessly clean, well-equipped, exceptional facilities."
        </blockquote>
        <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener" class="review-link">View the listing on Booking.com →</a>
      </div>
    </div>
  </section>

  <!-- Description -->
  <section class="section description-section">
    <div class="container-narrow">
      <div class="fade-in">
        <span class="eyebrow">The Residence</span>
        <h2>Turnkey Luxury · Furnished &amp; Move-In Ready</h2>
        <div class="gold-divider"></div>
        <div class="prose">
          <p class="lead">
            Located in the heart of Yas Island, just moments from iconic attractions such as Ferrari World, Yas Marina Circuit, and Yas Waterworld, this beautifully furnished corner studio at Mayan 2 presents a refined lifestyle in one of Abu Dhabi's most sought-after destinations.
          </p>
          <p>
            Rated <strong>8.5 on Booking.com</strong> by guests who praised its prime location, spotless condition, and exceptional amenities — this is a turnkey investment opportunity or an immediate move-in luxury home. As a corner unit on the 2nd floor, it benefits from enhanced natural light and twin balcony exposures, with views of both the Arabian Gulf and the resort-style Mayan community gardens.
          </p>
          <p>
            Designed for those who value comfort, convenience, and elegance, the residence offers a sophisticated, fully furnished living space complemented by the dynamic energy of island life — a well-connected address for individuals seeking an upscale, low-maintenance home in Abu Dhabi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section features-section">
    <div class="container">
      <div class="features-grid">
        <div class="features-col fade-in">
          <span class="eyebrow">Interior</span>
          <h3>Studio Features</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {interior.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="features-col fade-in">
          <span class="eyebrow">Building</span>
          <h3>Facilities &amp; Amenities</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {building.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Amenity images -->
  <section class="section amenity-images-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Building Amenities</span>
        <h2>Resort-grade living, every day.</h2>
        <div class="gold-divider"></div>
      </div>
      <div class="amenity-images-grid fade-in">
        <figure>
          <img src="/images/amenities/infinity-pool.jpg" alt="Resort infinity pool with beach view" loading="lazy" />
          <figcaption>Infinity pool</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/beach.jpg" alt="Private white-sand beach with turquoise water" loading="lazy" />
          <figcaption>Private beach</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/gym-new.jpg" alt="Fully-equipped building gym" loading="lazy" />
          <figcaption>Fully-equipped gym</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/sauna.jpg" alt="Sauna and wellness suite" loading="lazy" />
          <figcaption>Sauna &amp; steam</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section location-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Location</span>
        <h2>Yas Island — at the centre of it all.</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="location-grid">
        <div class="location-map fade-in">
          <iframe
            src="https://www.google.com/maps?q=Mayan+2+Yas+Island+Abu+Dhabi&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map of Mayan 2, Yas Island"
            allowfullscreen
          ></iframe>
        </div>
        <div class="nearby-list fade-in">
          <h3>Nearby</h3>
          <div class="gold-divider"></div>
          {nearby.map((n) => (
            <div class="nearby-row">
              <span class="nearby-place">{n.place}</span>
              <span class="nearby-dots"></span>
              <span class="nearby-time">{n.time}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="neighbourhood-grid fade-in">
        <figure>
          <img src="/images/amenities/beach-watersports.jpg" alt="Beach with water sports equipment" loading="lazy" />
          <figcaption>Private beach · 1 min</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/beach-panoramic.jpg" alt="Panoramic beach view with sun loungers" loading="lazy" />
          <figcaption>Yas Beach · 1 min</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/beach-water.jpg" alt="Beach view with Mayan building" loading="lazy" />
          <figcaption>Mayan 2 · Beachfront</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-text fade-in">
          <span class="eyebrow gold-on-dark">Inquiries</span>
          <h2 class="white-h">Schedule a Private Viewing</h2>
          <div class="gold-divider"></div>
          <p class="muted-on-dark">
            The studio is furnished, move-in ready, and privately offered for sale. Share a few details and the owner will follow up personally — or message directly on WhatsApp for the fastest response.
          </p>
          <div class="contact-meta">
            <div>
              <h5>WhatsApp</h5>
              <a class="wa-link" href="https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20the%20Furnished%20Corner%20Studio%20at%20Mayan%202%2C%202nd%20Floor." target="_blank" rel="noopener">
                <Icon name="whatsapp" size={18} /> +971 54 702 6170
              </a>
            </div>
            <div>
              <h5>Booking.com</h5>
              <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener">View the 8.5★ listing →</a>
            </div>
            <div>
              <h5>Location</h5>
              <span>Mayan 2 · Yas Island · Abu Dhabi</span>
            </div>
          </div>
        </div>
        <div class="contact-form-wrap fade-in">
          <InquiryForm property="Furnished Corner Studio · Mayan 2 · 2F" variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky mobile CTA -->
  <div class="sticky-cta">
    <div class="sticky-text">
      <div class="sticky-title">Furnished · Mayan 2 · 2F</div>
      <div class="sticky-sub">8.5★ · For Sale</div>
    </div>
    <a href="https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20the%20Furnished%20Corner%20Studio." target="_blank" rel="noopener" class="btn btn-gold sticky-btn">WhatsApp</a>
  </div>

  <!-- Floating WhatsApp button (desktop) -->
  <a href="https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20the%20Furnished%20Corner%20Studio." target="_blank" rel="noopener" class="whatsapp-fab" aria-label="WhatsApp the owner">
    <Icon name="whatsapp" size={26} />
  </a>
</Layout>

<style>
  .listing-hero {
    position: relative;
    height: 80vh;
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,25,59,0.35) 0%, rgba(17,25,59,0.15) 35%, rgba(17,25,59,0.85) 100%);
  }
  .listing-hero .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 4rem;
    padding-top: 8rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin-bottom: 1.5rem;
  }
  .back-link:hover { color: var(--gold); }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.25);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }
  .status-pill .dot {
    width: 8px;
    height: 8px;
    background: #4ADE80;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(74,222,128,0.25);
  }
  .listing-hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.0;
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: rgba(255,255,255,0.85);
    margin-bottom: 1.25rem;
  }
  .hero-rating { display: inline-block; }
  .rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--gold);
    color: var(--navy);
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .rating-pill strong { font-weight: 700; }

  /* Specs */
  .specs {
    background: var(--white);
    border-bottom: 1px solid var(--gray-warm);
    padding: 2rem 0;
  }
  .specs-inner {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }
  .spec {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--gold);
  }
  .spec > div {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .spec-num {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--navy);
  }
  .spec-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .specs-inner { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 480px) {
    .specs-inner { grid-template-columns: 1fr; }
  }

  .gallery-wrap {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  /* Booking review card */
  .booking-review { background: var(--ivory); padding: 2rem 0 4rem; }
  .review-inner { display: flex; justify-content: center; }
  .review-card {
    background: var(--white);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
    max-width: 720px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    border-top: 3px solid var(--gold);
  }
  .review-rating {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .rating-num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
  }
  .rating-meta { text-align: left; }
  .rating-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .rating-stars { color: var(--gold); display: flex; gap: 1px; margin-top: 4px; }
  .review-card blockquote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--navy);
    max-width: 580px;
  }
  .review-link {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* Description */
  .description-section { background: var(--white); }
  .prose .lead {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--navy);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  .prose p { font-size: 1.02rem; line-height: 1.85; margin-bottom: 1.25rem; }
  .prose strong { color: var(--navy); font-weight: 600; }

  /* Features */
  .features-section { background: var(--ivory); }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  @media (max-width: 768px) { .features-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .features-col h3 { margin-bottom: 0.5rem; }
  .feature-list {
    list-style: none;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .feature-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--gray-warm);
    font-size: 0.95rem;
    color: var(--navy);
  }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--white);
    color: var(--gold);
    flex-shrink: 0;
  }

  /* Amenity images */
  .amenity-images-section { background: var(--white); }
  .amenity-images-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 900px) { .amenity-images-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .amenity-images-grid { grid-template-columns: 1fr; } }
  .amenity-images-grid figure { position: relative; }
  .amenity-images-grid img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
  }
  .amenity-images-grid figcaption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--white);
    padding: 0.5rem 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* Location */
  .location-section { background: var(--ivory-warm); }
  .location-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: stretch;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) { .location-grid { grid-template-columns: 1fr; } }
  .location-map iframe {
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
    background: var(--ivory-warm);
  }
  .nearby-list {
    background: var(--white);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .nearby-list h3 { margin-bottom: 0.25rem; }
  .nearby-list .gold-divider { margin-bottom: 1rem; }
  .nearby-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
  }
  .nearby-place { color: var(--navy); font-weight: 500; }
  .nearby-dots { flex: 1; border-bottom: 1px dotted var(--gray-warm); transform: translateY(-4px); }
  .nearby-time { color: var(--gold); font-weight: 600; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .neighbourhood-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 768px) { .neighbourhood-grid { grid-template-columns: 1fr; } }
  .neighbourhood-grid figure { position: relative; }
  .neighbourhood-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .neighbourhood-grid figcaption {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(255,255,255,0.95);
    padding: 0.4rem 0.75rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* Contact */
  .contact-section { background: var(--navy); color: var(--white); }
  .white-h { color: var(--white); }
  .muted-on-dark { color: rgba(255,255,255,0.7); }
  .gold-on-dark { color: var(--gold-light); }
  .contact-grid {
    display: grid;
