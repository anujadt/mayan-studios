---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Gallery from '../components/Gallery.astro';
import RevenueChart from '../components/RevenueChart.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { cornerGallery, revenueStats, whatsappURL, whatsappDisplay, corner } from '../data/properties';

const interior = [
  { icon: 'check', text: 'Fully Furnished & Move-In Ready' },
  { icon: 'light', text: 'Corner Unit with Enhanced Natural Light' },
  { icon: 'bed', text: 'Comfortable Sleeping Area with Quality Bedding' },
  { icon: 'sofa', text: 'Stylish Living Area with Sofa, Smart TV & Dining' },
  { icon: 'check', text: 'Fully Equipped Kitchen (Oven, Microwave, Washing Machine, Coffee Maker)' },
  { icon: 'bath', text: 'Premium Bathroom with Designer Fixtures & Rain Shower' },
  { icon: 'view', text: 'Spacious Private Balcony with Sea & Community Views' },
  { icon: 'ac', text: 'Centralised Air Conditioning' },
  { icon: 'check', text: 'Built-in Wardrobe' },
];

const building = [
  { icon: 'concierge', text: '24/7 Concierge & Security' },
  { icon: 'gym', text: 'Fully-Equipped Gym (Cybex)' },
  { icon: 'pool', text: 'Infinity Pool & Children\'s Pools' },
  { icon: 'garden', text: 'Indoor & Outdoor Children\'s Playgrounds' },
  { icon: 'bbq', text: 'Barbecue Areas & Sun Decks' },
  { icon: 'beach', text: 'Direct Private Beach Access' },
  { icon: 'parking', text: 'Underground Covered Parking' },
  { icon: 'sauna', text: 'Sauna & Steam Rooms' },
];

const amenityPhotos = [
  { src: '/images/amenities/infinity-pool.jpg', alt: 'Infinity pool with beach view', caption: 'Infinity Pool' },
  { src: '/images/amenities/beach.jpg', alt: 'Private beach with turquoise water', caption: 'Private Beach' },
  { src: '/images/amenities/gym-new.jpg', alt: 'Fully-equipped Cybex gym', caption: 'Gym' },
  { src: '/images/amenities/sauna.jpg', alt: 'Sauna and steam suite', caption: 'Sauna' },
];

const nearby = [
  { place: 'Private Beach & Yas Links Golf', time: '1 min' },
  { place: 'Yas Bay Restaurants', time: '3 min' },
  { place: 'Yas Marina Circuit (F1)', time: '7 min' },
  { place: 'Ferrari World & Yas Waterworld', time: '7 min' },
  { place: 'Yas Mall (Shopping & Cinemas)', time: '9 min' },
  { place: 'Zayed International Airport', time: '10 min' },
  { place: 'Downtown Abu Dhabi', time: '25 min' },
  { place: 'Dubai', time: '50 min' },
];

const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Apartment',
  name: 'Luxury Corner Studio · Mayan 2 · 2nd Floor · Yas Island',
  description: 'A fully furnished corner studio at Mayan 2, Yas Island, Abu Dhabi. 2nd floor, ~550 sqft, private balcony with sea view, designer bathroom, fully-equipped kitchen, and access to private beach, infinity pool, gym, sauna.',
  numberOfRooms: 1,
  floorSize: { '@type': 'QuantitativeValue', value: 550, unitCode: 'FTK' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mayan 2, Yas Island',
    addressLocality: 'Abu Dhabi',
    addressCountry: 'AE',
  },
  amenityFeature: building.map((b) => ({ '@type': 'LocationFeatureSpecification', name: b.text })),
};
---
<Layout
  title="Luxury Corner Studio · Mayan 2 · Yas Island, Abu Dhabi"
  description="Fully furnished luxury corner studio at Mayan 2, Yas Island. 2nd floor, ~550 sqft, sea-view balcony, designer interiors, and access to the full Mayan amenity collection."
  ogImage={corner.hero}
>
  <script type="application/ld+json" set:html={JSON.stringify(listingSchema)} />

  <!-- HERO -->
  <section class="listing-hero">
    <div class="hero-image" style={`background-image: url('${corner.hero}')`}></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <span class="status-pill">
        <span class="dot"></span>
        <span>Available</span>
      </span>
      <h1>Luxury Corner Studio</h1>
      <div class="hero-sub">Mayan 2 · 2nd Floor · Yas Island</div>
    </div>
  </section>

  <!-- SPECS -->
  <section class="specs">
    <div class="container specs-inner">
      <div class="spec"><Icon name="bed" size={20} /><div><span class="spec-num">Studio</span><span class="spec-label">Layout</span></div></div>
      <div class="spec"><Icon name="bath" size={20} /><div><span class="spec-num">1 Bath</span><span class="spec-label">Designer Fixtures</span></div></div>
      <div class="spec"><Icon name="area" size={20} /><div><span class="spec-num">~550 sqft</span><span class="spec-label">Floor Area</span></div></div>
      <div class="spec"><Icon name="floor" size={20} /><div><span class="spec-num">2nd Floor</span><span class="spec-label">Corner Unit</span></div></div>
      <div class="spec"><Icon name="check" size={20} /><div><span class="spec-num">Furnished</span><span class="spec-label">Available</span></div></div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="container-narrow gallery-wrap">
    <Gallery images={cornerGallery} />
  </section>

  <!-- INVESTMENT PERFORMANCE -->
  <section id="revenue" class="section revenue-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow gold-on-dark">Investment Performance</span>
        <h2 class="white-h">Annual Revenue · AED 148,310</h2>
        <div class="gold-divider center"></div>
        <p class="rev-intro">
          Twelve months of monthly revenue from operating the studio as a short-stay rental — {revenueStats.reservations} bookings at {revenueStats.occupancy}% occupancy.
        </p>
      </div>

      <div class="rev-stats fade-in">
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.totalLabel}</div>
          <div class="rev-lbl">Annual Revenue</div>
        </div>
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.reservations}</div>
          <div class="rev-lbl">Bookings</div>
        </div>
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.occupancy}%</div>
          <div class="rev-lbl">Occupancy</div>
        </div>
        <div class="rev-stat">
          <div class="rev-num">{revenueStats.averageMonthlyLabel}</div>
          <div class="rev-lbl">Avg / Month</div>
        </div>
      </div>

      <div class="rev-chart-card fade-in">
        <div class="rev-chart-head">
          <div class="rev-chart-eyebrow">Monthly Revenue · Apr – Mar</div>
          <div class="rev-chart-title">Gross monthly revenue in AED.</div>
        </div>
        <RevenueChart />
      </div>
    </div>
  </section>

  <!-- DESCRIPTION -->
  <section class="section description-section">
    <div class="container-narrow">
      <div class="fade-in">
        <span class="eyebrow">The Residence</span>
        <h2>Furnished, Corner, Move-In Ready.</h2>
        <div class="gold-divider"></div>
        <div class="prose">
          <p class="lead">
            A beautifully furnished corner studio at Mayan 2 — refined, low-maintenance, and steps from the Arabian Gulf.
          </p>
          <p>
            As a corner unit on the 2nd floor, it benefits from enhanced natural light and twin-balcony exposures, with views of both the community gardens and the resort-style pool deck. Move-in ready as a home, or guest-ready from day one as a short-stay rental.
          </p>
          <p>
            Within easy reach of Yas Marina Circuit, Ferrari World, Yas Waterworld, and Yas Mall — and minutes from Zayed International Airport.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section features-section">
    <div class="container">
      <div class="features-grid">
        <div class="features-col fade-in">
          <span class="eyebrow">Interior</span>
          <h3>Studio Features</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {interior.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="features-col fade-in">
          <span class="eyebrow">Building</span>
          <h3>Facilities &amp; Amenities</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {building.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- AMENITIES PHOTOS -->
  <section class="section amenities-photos-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Amenities</span>
        <h2>The Mayan Collection.</h2>
        <div class="gold-divider center"></div>
      </div>
      <div class="amenity-grid fade-in">
        {amenityPhotos.map((p) => (
          <figure>
            <img src={p.src} alt={p.alt} loading="lazy" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section location-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Location</span>
        <h2>Yas Island — at the centre of it all.</h2>
        <div class="gold-divider center"></div>
      </div>

      <div class="location-grid">
        <div class="location-map fade-in">
          <iframe
            src="https://www.google.com/maps?q=Mayan+2+Yas+Island+Abu+Dhabi&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map of Mayan 2, Yas Island"
            allowfullscreen
          ></iframe>
        </div>
        <div class="nearby-list fade-in">
          <h3>Nearby</h3>
          <div class="gold-divider"></div>
          {nearby.map((n) => (
            <div class="nearby-row">
              <span class="nearby-place">{n.place}</span>
              <span class="nearby-dots"></span>
              <span class="nearby-time">{n.time}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-text fade-in">
          <span class="eyebrow gold-on-dark">Inquiries</span>
          <h2 class="white-h">Schedule a Private Viewing</h2>
          <div class="gold-divider"></div>
          <p class="muted-on-dark">
            Share a few details and the owner will follow up personally — or message directly on WhatsApp for the fastest response.
          </p>
          <div class="contact-meta">
            <div>
              <h5>WhatsApp</h5>
              <a class="wa-link" href={whatsappURL} target="_blank" rel="noopener">
                <Icon name="whatsapp" size={18} /> {whatsappDisplay}
              </a>
            </div>
            <div>
              <h5>Location</h5>
              <span>Mayan 2 · Yas Island · Abu Dhabi</span>
            </div>
          </div>
        </div>
        <div class="contact-form-wrap fade-in">
          <InquiryForm property="Luxury Corner Studio · Mayan 2" variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <StickyCTA />
</Layout>

<style>
  .listing-hero {
    position: relative;
    height: 78vh;
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,25,59,0.35) 0%, rgba(17,25,59,0.15) 35%, rgba(17,25,59,0.85) 100%);
  }
  .listing-hero .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 4rem;
    padding-top: 8rem;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.25);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }
  .status-pill .dot {
    width: 8px;
    height: 8px;
    background: #4ADE80;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(74,222,128,0.25);
  }
  .listing-hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.0;
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: rgba(255,255,255,0.85);
  }

  /* Specs */
  .specs {
    background: var(--white);
    border-bottom: 1px solid var(--gray-warm);
    padding: 2rem 0;
  }
  .specs-inner {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }
  .spec {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--gold);
  }
  .spec > div { display: flex; flex-direction: column; line-height: 1.2; }
  .spec-num {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--navy);
  }
  .spec-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .specs-inner { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 480px) {
    .specs-inner { grid-template-columns: 1fr; }
  }

  .gallery-wrap { padding-top: 3rem; padding-bottom: 1rem; }

  /* REVENUE */
  .revenue-section {
    background: linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 100%);
    color: var(--white);
  }
  .revenue-section .section-header { margin-bottom: 3rem; text-align: center; }
  .gold-on-dark { color: var(--gold-light); }
  .white-h { color: var(--white); }
  .rev-intro {
    max-width: 640px;
    margin: 1.25rem auto 0;
    color: rgba(255,255,255,0.78);
    font-size: 1rem;
    line-height: 1.7;
  }
  .rev-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-bottom: 3rem;
    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  @media (max-width: 768px) {
    .rev-stats { grid-template-columns: repeat(2, 1fr); }
  }
  .rev-stat {
    padding: 1.75rem 1rem;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.08);
  }
  .rev-stat:last-child { border-right: none; }
  @media (max-width: 768px) {
    .rev-stat:nth-child(2n) { border-right: none; }
    .rev-stat:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.08); }
  }
  .rev-num {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    color: var(--gold-light);
    font-weight: 600;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .rev-lbl {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }
  .rev-chart-card {
    background: var(--white);
    padding: 2.25rem;
  }
  @media (max-width: 600px) { .rev-chart-card { padding: 1.5rem 1rem; } }
  .rev-chart-head { margin-bottom: 1.5rem; }
  .rev-chart-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.35rem;
  }
  .rev-chart-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--navy);
    line-height: 1.4;
  }

  /* Description */
  .description-section { background: var(--white); }
  .prose .lead {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--navy);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  .prose p { font-size: 1.02rem; line-height: 1.85; margin-bottom: 1.25rem; }

  /* Features */
  .features-section { background: var(--ivory); }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  @media (max-width: 768px) { .features-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .features-col h3 { margin-bottom: 0.5rem; }
  .feature-list {
    list-style: none;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .feature-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--gray-warm);
    font-size: 0.95rem;
    color: var(--navy);
  }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--white);
    color: var(--gold);
    flex-shrink: 0;
  }

  /* Amenities photos */
  .amenities-photos-section { background: var(--white); }
  .amenities-photos-section .section-header { text-align: center; margin-bottom: 2.5rem; }
  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 900px) { .amenity-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .amenity-grid { grid-template-columns: 1fr; } }
  .amenity-grid figure { position: relative; margin: 0; overflow: hidden; }
  .amenity-grid img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    transition: transform 600ms ease;
  }
  .amenity-grid figure:hover img { transform: scale(1.04); }
  .amenity-grid figcaption {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    background: rgba(255,255,255,0.95);
    padding: 0.4rem 0.75rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* Location */
  .location-section { background: var(--ivory-warm); }
  .location-section .section-header { text-align: center; margin-bottom: 2.5rem; }
  .location-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }
  @media (max-width: 900px) { .location-grid { grid-template-columns: 1fr; } }
  .location-map iframe {
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
    background: var(--ivory-warm);
  }
  .nearby-list {
    background: var(--white);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .nearby-list h3 { margin-bottom: 0.25rem; }
  .nearby-list .gold-divider { margin-bottom: 1rem; }
  .nearby-row { display: flex; align-items: baseline; gap: 0.75rem; font-size: 0.95rem; }
  .nearby-place { color: var(--navy); font-weight: 500; }
  .nearby-dots { flex: 1; border-bottom: 1px dotted var(--gray-warm); transform: translateY(-4px); }
  .nearby-time { color: var(--gold); font-weight: 600; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }

  /* Contact */
  .contact-section { background: var(--navy); color: var(--white); padding-bottom: 8rem; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .contact-text p { font-size: 1.02rem; line-height: 1.8; margin-bottom: 2.5rem; }
  .contact-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 560px) { .contact-meta { grid-template-columns: 1fr; } }
  .contact-meta h5 {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.35rem;
    font-weight: 600;
  }
  .contact-meta a { color: var(--white); font-size: 0.98rem; display: inline-flex; align-items: center; gap: 0.5rem; }
  .contact-meta a:hover { color: var(--gold); }
  .wa-link { color: var(--gold-light) !important; }
  .muted-on-dark { color: rgba(255,255,255,0.7); }
</style>
