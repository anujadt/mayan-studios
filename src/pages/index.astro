---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { properties } from '../data/properties';

const highlights = [
  { icon: 'beach', name: 'Private Beach', desc: 'White-sand beach with turquoise water, steps away' },
  { icon: 'pool', name: 'Infinity Pool', desc: 'Resort-style pool overlooking the Arabian Gulf' },
  { icon: 'star', name: '8.5★ on Booking.com', desc: 'Guest-rated by visitors who stayed at Mayan 2' },
  { icon: 'view', name: 'Minutes from F1 Circuit', desc: 'Yas Marina Circuit, Ferrari World & Yas Waterworld' },
];

const distances = [
  { place: 'Private beach & golf course', time: '1 min' },
  { place: 'Yas Bay restaurants', time: '3 min' },
  { place: 'Yas Marina Circuit (F1)', time: '7 min' },
  { place: 'Ferrari World & Yas Waterworld', time: '7 min' },
  { place: 'Yas Mall', time: '9 min' },
  { place: 'Zayed International Airport', time: '10 min' },
  { place: 'Saadiyat Island', time: '20 min' },
  { place: 'Downtown Abu Dhabi', time: '25 min' },
  { place: 'Dubai', time: '50 min' },
];
---
<Layout
  title="Luxury Studio Apartments on Yas Island · For Sale · 8.5★ on Booking.com"
  description="A furnished corner studio for sale at Mayan 2, Yas Island, Abu Dhabi. 8.5★ rated on Booking.com — private beach, infinity pool, minutes from F1 Circuit."
  ogImage="/images/amenities/infinity-pool.jpg"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-image" style="background-image: url('/images/amenities/infinity-pool.jpg')"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <span class="hero-eyebrow">Mayan 2 · Yas Island · Abu Dhabi</span>
      <h1>Luxury Studio Apartments<br/>on Yas Island</h1>
      <div class="hero-tag">Premium beachfront living in the heart of Abu Dhabi's most iconic destination</div>
      <div class="hero-badge">
        <span class="badge-star"><Icon name="star" size={16} /></span>
        <span><strong>8.5</strong> · Rated on Booking.com</span>
      </div>
      <p class="hero-lead">
        A privately offered, fully furnished corner studio at Mayan 2 — Aldar's waterfront community on Yas Island. Turnkey, beach-front, and now available for sale.
      </p>
      <div class="hero-cta">
        <a href="#portfolio" class="btn btn-gold">Explore the Listing</a>
        <a href="https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20the%20Yas%20Island%20studio." class="btn btn-outline-light" target="_blank" rel="noopener">WhatsApp the Owner</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section intro fade-in">
    <div class="container-narrow intro-inner">
      <span class="eyebrow">A Private Listing</span>
      <h2>An island address. A turnkey home.</h2>
      <div class="gold-divider center"></div>
      <p>
        Set within Aldar's waterfront Mayan community, this furnished corner studio captures the quiet confidence of Yas Island — moments from the Arabian Gulf, Yas Links Golf Course, and the city's most defining cultural and lifestyle destinations.
      </p>

      <div class="intro-stats">
        <div>
          <div class="stat-num">8.5★</div>
          <div class="stat-lbl">Booking.com</div>
        </div>
        <div>
          <div class="stat-num">Furnished</div>
          <div class="stat-lbl">Move-in Ready</div>
        </div>
        <div>
          <div class="stat-num">For Sale</div>
          <div class="stat-lbl">Privately Offered</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section id="portfolio" class="section portfolio">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">The Listings</span>
        <h2>One active studio. One on the way.</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="property-grid">
        {properties.map((p) => (
          <article class={`property-card fade-in ${p.status}`}>
            {p.status === 'active' ? (
              <a href={`/${p.slug}`} class="card-link" aria-label={p.title}>
                <div class="card-image" style={`background-image: url('${p.hero}')`}>
                  <span class={`status-badge ${p.status}`}>{p.statusLabel}</span>
                </div>
                <div class="card-body">
                  <h3>{p.shortTitle}</h3>
                  <div class="card-meta">
                    <span>{p.floor}</span>
                    <span class="dot">·</span>
                    <span>{p.size}</span>
                    <span class="dot">·</span>
                    <span>{p.beds}</span>
                  </div>
                  <p>{p.hook}</p>
                  <div class="card-cta">
                    View Details
                    <Icon name="arrow" size={16} />
                  </div>
                </div>
              </a>
            ) : (
              <div class="card-link" aria-label={p.title}>
                <div class="card-image" style={`background-image: url('${p.hero}')`}>
                  <span class={`status-badge ${p.status}`}>{p.statusLabel}</span>
                </div>
                <div class="card-body">
                  <h3>{p.shortTitle}</h3>
                  <div class="card-meta">
                    <span>{p.floor}</span>
                    <span class="dot">·</span>
                    <span>{p.size}</span>
                    <span class="dot">·</span>
                    <span>{p.beds}</span>
                  </div>
                  <p>{p.hook}</p>
                  <a href="#contact" class="card-cta">
                    Register Interest
                    <Icon name="arrow" size={16} />
                  </a>
                </div>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="section highlights-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">What sets it apart</span>
        <h2>Highlights of the address.</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="highlights-grid">
        {highlights.map((h) => (
          <div class="highlight fade-in">
            <div class="highlight-icon"><Icon name={h.icon} size={28} /></div>
            <h4>{h.name}</h4>
            <p>{h.desc}</p>
          </div>
        ))}
      </div>

      <div class="highlight-images fade-in">
        <figure><img src="/images/amenities/beach.jpg" alt="Private beach with white sand and turquoise water" loading="lazy" /></figure>
        <figure><img src="/images/amenities/infinity-pool.jpg" alt="Infinity pool with beach view" loading="lazy" /></figure>
        <figure><img src="/images/amenities/gym-new.jpg" alt="Building gym" loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section location-section">
    <div class="container">
      <div class="location-grid">
        <div class="location-text fade-in">
          <span class="eyebrow">Location</span>
          <h2>At the heart of Yas Island.</h2>
          <div class="gold-divider"></div>
          <p>
            Mayan is Aldar's waterfront community on Yas Island — an enclave of low-rise residences set between the Arabian Gulf and Yas Links Golf Course. Minutes from Yas Mall, Ferrari World, Yas Waterworld, and Zayed International Airport, with downtown Abu Dhabi and Dubai both within easy reach.
          </p>
          <div class="distance-list">
            {distances.map((d) => (
              <div class="distance-row">
                <span class="distance-place">{d.place}</span>
                <span class="distance-dots"></span>
                <span class="distance-time">{d.time}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="location-photo fade-in">
          <img src="/images/amenities/beach-water.jpg" alt="Beach with Mayan building behind" loading="lazy" />
          <div class="location-photo-cap">Mayan 2 · Beachfront</div>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOKING BANNER -->
  <section class="booking-banner fade-in">
    <div class="container booking-inner">
      <div class="booking-text">
        <span class="booking-rating"><Icon name="star" size={20} /><strong>8.5</strong></span>
        <div>
          <h3 class="white-h">Rated 8.5 on Booking.com</h3>
          <p class="muted-on-dark">"Perfect luxury stay with excellent value for money. Spotlessly clean, well-equipped, exceptional facilities."</p>
        </div>
      </div>
      <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener" class="btn btn-gold">View on Booking.com</a>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-text fade-in">
          <span class="eyebrow gold-on-dark">Inquiries</span>
          <h2 class="white-h">Schedule a private viewing.</h2>
          <div class="gold-divider"></div>
          <p class="muted-on-dark">
            The studio is privately offered for sale. Share a few details below and the owner will respond personally — or reach out directly on WhatsApp for the fastest response.
          </p>
          <div class="contact-meta">
            <div>
              <h5>WhatsApp</h5>
              <a href="https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20the%20Yas%20Island%20studio." target="_blank" rel="noopener">+971 54 702 6170</a>
            </div>
            <div>
              <h5>Booking.com</h5>
              <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener">View the 8.5★ listing →</a>
            </div>
            <div>
              <h5>Location</h5>
              <span>Mayan 2 · Yas Island · Abu Dhabi</span>
            </div>
          </div>
        </div>

        <div class="contact-form-wrap fade-in">
          <InquiryForm property="Luxury Studios on Yas Island" variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <!-- Floating WhatsApp button -->
  <a href="https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20the%20Yas%20Island%20studio." target="_blank" rel="noopener" class="whatsapp-fab" aria-label="WhatsApp the owner">
    <Icon name="whatsapp" size={26} />
  </a>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    color: var(--white);
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
    animation: kenburns 22s ease-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1.0) translate(0,0); }
    to { transform: scale(1.12) translate(-1%, -2%); }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,25,59,0.55) 0%, rgba(17,25,59,0.30) 35%, rgba(17,25,59,0.80) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 8rem;
    padding-bottom: 8rem;
    max-width: 880px;
  }
  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 6.5vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    color: rgba(255,255,255,0.88);
    margin-bottom: 1.75rem;
    max-width: 680px;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.22);
    color: var(--white);
    font-size: 0.92rem;
    padding: 0.55rem 1rem;
    margin-bottom: 1.5rem;
  }
  .hero-badge strong { color: var(--gold-light); font-weight: 700; }
  .badge-star { color: var(--gold-light); display: inline-flex; }
  .hero-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    max-width: 620px;
    margin-bottom: 2.5rem;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255,255,255,0.7);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, var(--gold), transparent);
    animation: pulse 2s ease infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.5; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* INTRO */
  .intro { background: var(--ivory); text-align: center; }
  .intro-inner { display: flex; flex-direction: column; align-items: center; }
  .intro p { font-size: 1.15rem; line-height: 1.8; max-width: 640px; color: var(--text); }
  .intro-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
    width: 100%;
    max-width: 720px;
    padding-top: 2.5rem;
    border-top: 1px solid var(--gray-warm);
  }
  .stat-num {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .stat-lbl {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  @media (max-width: 560px) {
    .intro-stats { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  /* PORTFOLIO */
  .portfolio { background: var(--white); }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .section-header .gold-divider { margin-left: auto; margin-right: auto; }

  .property-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  @media (max-width: 900px) {
    .property-grid { grid-template-columns: 1fr; }
  }
  .property-card {
    background: var(--ivory);
    overflow: hidden;
    transition: transform 500ms cubic-bezier(0.2,0.8,0.2,1), box-shadow 500ms ease;
  }
  .property-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .property-card.coming-soon .card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(17,25,59,0.45);
  }
  .card-link { display: block; }
  .card-image {
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    transition: transform 700ms ease;
  }
  .property-card:hover .card-image {
    transform: scale(1.04);
  }
  .status-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    z-index: 2;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.5rem 0.9rem;
    background: var(--white);
    color: var(--navy);
  }
  .status-badge.coming-soon {
    background: var(--gold);
    color: var(--white);
  }
  .card-body {
    padding: 2rem;
  }
  .card-body h3 {
    margin-bottom: 0.5rem;
  }
  .card-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
  }
  .card-meta .dot { margin: 0 0.4rem; color: var(--gold); }
  .card-body p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    padding-top: 1rem;
    border-top: 1px solid var(--gray-warm);
    width: 100%;
    justify-content: space-between;
  }
  .card-cta :global(svg) {
    transition: transform 300ms ease;
  }
  .property-card:hover .card-cta :global(svg) {
    transform: translateX(6px);
  }

  /* HIGHLIGHTS */
  .highlights-section { background: var(--ivory); }
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }
  @media (max-width: 900px) { .highlights-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .highlights-grid { grid-template-columns: 1fr; } }
  .highlight {
    padding: 1.5rem 0;
    border-top: 1px solid var(--gray-warm);
  }
  .highlight-icon { color: var(--gold); margin-bottom: 1rem; }
  .highlight h4 {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    color: var(--navy);
    letter-spacing: 0.02em;
    text-transform: none;
    font-family: var(--font-serif);
    font-weight: 600;
  }
  .highlight p { font-size: 0.9rem; line-height: 1.6; }
  .highlight-images {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 768px) { .highlight-images { grid-template-columns: 1fr; } }
  .highlight-images img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  /* LOCATION */
  .location-section { background: var(--ivory-warm); }
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 900px) { .location-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .location-text p { font-size: 1.02rem; line-height: 1.8; margin-bottom: 2rem; }
  .distance-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .distance-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
  }
  .distance-place { color: var(--navy); font-weight: 500; }
  .distance-dots {
    flex: 1;
    border-bottom: 1px dotted var(--gray-warm);
    transform: translateY(-4px);
  }
  .distance-time {
    color: var(--gold);
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .location-photo { position: relative; }
  .location-photo img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
  }
  .location-photo-cap {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--white);
    padding: 0.6rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* Booking banner */
  .booking-banner {
    background: var(--navy);
    color: var(--white);
    padding: 3rem 0;
  }
  .booking-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .booking-text {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .booking-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--gold);
    color: var(--navy);
    padding: 0.8rem 1.1rem;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
  }
  .booking-text h3 { margin-bottom: 0.25rem; font-family: var(--font-serif); font-size: 1.2rem; }
  .booking-text p { font-style: italic; max-width: 540px; }

  /* CONTACT */
  .contact-section {
    background: var(--navy);
    color: var(--white);
  }
  .white-h { color: var(--white); }
  .muted-on-dark { color: rgba(255,255,255,0.7); }
  .gold-on-dark { color: var(--gold-light); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .contact-text p { font-size: 1.02rem; line-height: 1.8; margin-bottom: 2.5rem; }
  .contact-meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .contact-meta h5 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.35rem;
    font-weight: 600;
  }
  .contact-meta a { color: var(--white); font-size: 1rem; }
  .contact-meta a:hover { color: var(--gold); }
  .contact-meta span { color: rgba(255,255,255,0.85); }

  /* WhatsApp floating button */
  .whatsapp-fab {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--green);
    color: var(--white);
    display: grid;
    place-items: center;
    z-index: 90;
    box-shadow: 0 8px 24px rgba(37,211,102,0.45);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .whatsapp-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 12px 32px rgba(37,211,102,0.6);
    color: var(--white);
  }
</style>
