---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { properties } from '../data/properties';

const amenities = [
  { icon: 'pool', name: 'Rooftop Pool', desc: 'Resort-style infinity pool with skyline views' },
  { icon: 'beach', name: 'Direct Beach Access', desc: 'Private beach a one-minute walk away' },
  { icon: 'gym', name: 'Fully-Equipped Gym', desc: 'State-of-the-art fitness facilities' },
  { icon: 'concierge', name: '24/7 Concierge', desc: 'Round-the-clock service and security' },
  { icon: 'bbq', name: 'BBQ & Sun Decks', desc: 'Outdoor entertaining at every level' },
  { icon: 'sauna', name: 'Sauna & Steam', desc: 'Spa-grade wellness amenities' },
  { icon: 'garden', name: 'Landscaped Gardens', desc: 'Quiet courtyards and play areas' },
  { icon: 'parking', name: 'Covered Parking', desc: 'Secure underground parking' },
];

const distances = [
  { place: 'The beach & golf course', time: '1 min' },
  { place: 'Yas Bay restaurants', time: '3 min' },
  { place: 'Yas Marina Circuit (F1)', time: '7 min' },
  { place: 'Yas Mall', time: '9 min' },
  { place: 'Zayed International Airport', time: '10 min' },
  { place: 'Downtown Abu Dhabi', time: '25 min' },
  { place: 'Saadiyat Island', time: '20 min' },
  { place: 'Dubai', time: '50 min' },
];
---
<Layout
  title="Mayan Studios · Luxury Living on Yas Island, Abu Dhabi"
  description="A private portfolio of two studio residences at Mayan 2 — Aldar's waterfront community on Yas Island. Concierge, pools, private beach, Yas Links Golf Course adjacent."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-image" style="background-image: url('/images/studio-a/01-balcony-sunset.webp')"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <span class="hero-eyebrow">Aldar · Mayan 2 · Yas Island</span>
      <h1>Mayan Studios</h1>
      <div class="hero-tag">Luxury Living on Yas Island, Abu Dhabi</div>
      <p class="hero-lead">
        Two exclusive studio residences in one of Abu Dhabi's most sought-after waterfront communities — presented privately to a select audience.
      </p>
      <div class="hero-cta">
        <a href="#portfolio" class="btn btn-gold">Explore the Portfolio</a>
        <a href="#contact" class="btn btn-outline-light">Schedule a Viewing</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section intro fade-in">
    <div class="container-narrow intro-inner">
      <span class="eyebrow">A Private Property Portfolio</span>
      <h2>An island address, two refined residences.</h2>
      <div class="gold-divider center"></div>
      <p>
        Set within Aldar's waterfront Mayan community, these two studio apartments capture the quiet confidence of Yas Island — moments from the Arabian Gulf, Yas Links Golf Course, and the city's most defining cultural and lifestyle destinations.
      </p>

      <div class="intro-stats">
        <div>
          <div class="stat-num">2</div>
          <div class="stat-lbl">Residences</div>
        </div>
        <div>
          <div class="stat-num">Mayan 2</div>
          <div class="stat-lbl">Tower</div>
        </div>
        <div>
          <div class="stat-num">Yas Island</div>
          <div class="stat-lbl">Abu Dhabi</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section id="portfolio" class="section portfolio">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">The Portfolio</span>
        <h2>Two studios. One iconic address.</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="property-grid">
        {properties.map((p) => (
          <article class={`property-card fade-in ${p.status}`}>
            <a href={`/${p.slug}`} class="card-link" aria-label={p.title}>
              <div class="card-image" style={`background-image: url('${p.hero}')`}>
                <span class={`status-badge ${p.status}`}>{p.statusLabel}</span>
              </div>
              <div class="card-body">
                <h3>{p.shortTitle}</h3>
                <div class="card-meta">
                  <span>{p.floor}</span>
                  <span class="dot">·</span>
                  <span>{p.size}</span>
                  <span class="dot">·</span>
                  <span>{p.beds}</span>
                </div>
                <p>{p.hook}</p>
                <div class="card-cta">
                  {p.status === 'active' ? 'View Details' : 'Register Interest'}
                  <Icon name="arrow" size={16} />
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section location-section">
    <div class="container">
      <div class="location-grid">
        <div class="location-text fade-in">
          <span class="eyebrow">Location</span>
          <h2>At the heart of Yas Island.</h2>
          <div class="gold-divider"></div>
          <p>
            Mayan is Aldar's waterfront community on Yas Island — an enclave of low-rise residences set between the Arabian Gulf and Yas Links Golf Course. Minutes from Yas Mall, Ferrari World, Yas Waterworld, and Zayed International Airport, with downtown Abu Dhabi and Dubai both within easy reach.
          </p>
          <div class="distance-list">
            {distances.map((d) => (
              <div class="distance-row">
                <span class="distance-place">{d.place}</span>
                <span class="distance-dots"></span>
                <span class="distance-time">{d.time}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="location-photo fade-in">
          <img src="/images/location/mayan-exterior.jpeg" alt="Mayan towers viewed from the sea" loading="lazy" />
          <div class="location-photo-cap">Mayan 2 · Aldar Properties</div>
        </div>
      </div>
    </div>
  </section>

  <!-- AMENITIES -->
  <section class="section amenities-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Building Amenities</span>
        <h2>The Mayan way of life.</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="amenities-grid">
        {amenities.map((a) => (
          <div class="amenity fade-in">
            <div class="amenity-icon">
              <Icon name={a.icon} size={28} />
            </div>
            <h4>{a.name}</h4>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>

      <div class="amenity-images fade-in">
        <figure><img src="/images/amenities/rooftop-pool.webp" alt="Rooftop pool" loading="lazy" /></figure>
        <figure><img src="/images/amenities/gym.webp" alt="Building gym" loading="lazy" /></figure>
        <figure><img src="/images/location/al-marasy-marina.jpeg" alt="Marina promenade" loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-text fade-in">
          <span class="eyebrow gold-on-dark">Inquiries</span>
          <h2 class="white-h">Schedule a private viewing.</h2>
          <div class="gold-divider"></div>
          <p class="muted-on-dark">
            Both residences are offered privately. Share a few details and the owner will respond personally — or reach out directly on WhatsApp for the fastest response.
          </p>
          <div class="contact-meta">
            <div>
              <h5>Email</h5>
              <a href="mailto:hello@mayanstudios.example">hello@mayanstudios.example</a>
            </div>
            <div>
              <h5>WhatsApp</h5>
              <a href="https://wa.me/971500000000" target="_blank" rel="noopener">+971 50 000 0000</a>
            </div>
            <div>
              <h5>Location</h5>
              <span>Mayan 2 · Yas Island · Abu Dhabi</span>
            </div>
          </div>
        </div>

        <div class="contact-form-wrap fade-in">
          <InquiryForm property="Mayan Studios Portfolio" variant="dark" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    color: var(--white);
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
    animation: kenburns 22s ease-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1.0) translate(0,0); }
    to { transform: scale(1.12) translate(-1%, -2%); }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,25,59,0.55) 0%, rgba(17,25,59,0.30) 35%, rgba(17,25,59,0.75) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 8rem;
    padding-bottom: 8rem;
    max-width: 860px;
  }
  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: rgba(255,255,255,0.85);
    margin-bottom: 1.75rem;
  }
  .hero-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    max-width: 600px;
    margin-bottom: 2.5rem;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255,255,255,0.7);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, var(--gold), transparent);
    animation: pulse 2s ease infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.5; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* INTRO */
  .intro { background: var(--ivory); text-align: center; }
  .intro-inner { display: flex; flex-direction: column; align-items: center; }
  .intro p { font-size: 1.15rem; line-height: 1.8; max-width: 640px; color: var(--text); }
  .intro-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
    width: 100%;
    max-width: 640px;
    padding-top: 2.5rem;
    border-top: 1px solid var(--gray-warm);
  }
  .stat-num {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .stat-lbl {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  @media (max-width: 560px) {
    .intro-stats { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  /* PORTFOLIO */
  .portfolio { background: var(--white); }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .section-header .gold-divider { margin-left: auto; margin-right: auto; }

  .property-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  @media (max-width: 900px) {
    .property-grid { grid-template-columns: 1fr; }
  }
  .property-card {
    background: var(--ivory);
    overflow: hidden;
    transition: transform 500ms cubic-bezier(0.2,0.8,0.2,1), box-shadow 500ms ease;
  }
  .property-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .property-card.coming-soon .card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(17,25,59,0.35);
  }
  .card-link { display: block; }
  .card-image {
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    transition: transform 700ms ease;
  }
  .property-card:hover .card-image {
    transform: scale(1.04);
  }
  .status-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    z-index: 2;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.5rem 0.9rem;
    background: var(--white);
    color: var(--navy);
  }
  .status-badge.coming-soon {
    background: var(--gold);
    color: var(--white);
  }
  .card-body {
    padding: 2rem;
  }
  .card-body h3 {
    margin-bottom: 0.5rem;
  }
  .card-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
  }
  .card-meta .dot { margin: 0 0.4rem; color: var(--gold); }
  .card-body p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    padding-top: 1rem;
    border-top: 1px solid var(--gray-warm);
    width: 100%;
    justify-content: space-between;
  }
  .card-cta :global(svg) {
    transition: transform 300ms ease;
  }
  .property-card:hover .card-cta :global(svg) {
    transform: translateX(6px);
  }

  /* LOCATION */
  .location-section { background: var(--ivory-warm); }
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 900px) { .location-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .location-text p { font-size: 1.02rem; line-height: 1.8; margin-bottom: 2rem; }
  .distance-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .distance-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
  }
  .distance-place { color: var(--navy); font-weight: 500; }
  .distance-dots {
    flex: 1;
    border-bottom: 1px dotted var(--gray-warm);
    transform: translateY(-4px);
  }
  .distance-time {
    color: var(--gold);
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .location-photo {
    position: relative;
  }
  .location-photo img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
  }
  .location-photo-cap {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--white);
    padding: 0.6rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* AMENITIES */
  .amenities-section { background: var(--white); }
  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }
  @media (max-width: 900px) { .amenities-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .amenities-grid { grid-template-columns: 1fr; } }
  .amenity {
    padding: 1.5rem 0;
    border-top: 1px solid var(--gray-warm);
  }
  .amenity-icon {
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .amenity h4 {
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    color: var(--navy);
    letter-spacing: 0.05em;
    text-transform: none;
    font-family: var(--font-serif);
    font-weight: 600;
  }
  .amenity p {
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .amenity-images {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 768px) { .amenity-images { grid-template-columns: 1fr; } }
  .amenity-images img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  /* CONTACT */
  .contact-section {
    background: var(--navy);
    color: var(--white);
  }
  .white-h { color: var(--white); }
  .muted-on-dark { color: rgba(255,255,255,0.7); }
  .gold-on-dark { color: var(--gold-light); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .contact-text p { font-size: 1.02rem; line-height: 1.8; margin-bottom: 2.5rem; }
  .contact-meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .contact-meta h5 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.35rem;
    font-weight: 600;
  }
  .contact-meta a { color: var(--white); font-size: 1rem; }
  .contact-meta a:hover { color: var(--gold); }
  .contact-meta span { color: rgba(255,255,255,0.85); }
</style>
