---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { corner, cityView, whatsappURL, whatsappDisplay } from '../data/properties';

const distances = [
  { place: 'Private beach & Yas Links golf', time: '1 min' },
  { place: 'Yas Bay restaurants', time: '3 min' },
  { place: 'Yas Marina Circuit (F1)', time: '7 min' },
  { place: 'Ferrari World & Yas Waterworld', time: '7 min' },
  { place: 'Yas Mall', time: '9 min' },
  { place: 'Zayed International Airport', time: '10 min' },
  { place: 'Downtown Abu Dhabi', time: '25 min' },
  { place: 'Dubai', time: '50 min' },
];
---
<Layout
  title="Luxury Studio Apartments on Yas Island"
  description="A private portfolio of two luxury studio apartments at Mayan 2, Yas Island, Abu Dhabi. One available, one sold."
  ogImage="/images/amenities/infinity-pool.jpg"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-image" style="background-image: url('/images/amenities/infinity-pool.jpg')"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <span class="hero-eyebrow">Mayan 2 · Yas Island · Abu Dhabi</span>
      <h1>Luxury Studio Apartments<br/>on Yas Island</h1>
      <p class="hero-tag">A private portfolio of two studios at Aldar's waterfront community — set between the Arabian Gulf and Yas Links Golf Course.</p>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section class="section portfolio">
    <div class="container">
      <div class="portfolio-head fade-in">
        <span class="eyebrow">The Portfolio</span>
        <h2>Two studios at Mayan 2.</h2>
        <div class="gold-divider center"></div>
      </div>

      <div class="portfolio-grid">
        <a href={corner.href} class="prop-card fade-in">
          <div class="prop-image">
            <img src={corner.cardImage} alt="Luxury corner studio interior at Mayan 2" loading="eager" />
            <span class="prop-badge badge-available">{corner.badge}</span>
          </div>
          <div class="prop-body">
            <div class="prop-meta">
              <span>{corner.floor}</span><span class="dot">·</span><span>Furnished</span>
            </div>
            <h3 class="prop-title">{corner.title}</h3>
            <p class="prop-hook">{corner.hook}</p>
            <div class="prop-cta">
              <span>View Studio</span>
              <Icon name="arrow" size={16} />
            </div>
          </div>
        </a>

        <a href={cityView.href} class="prop-card sold fade-in">
          <div class="prop-image">
            <img src={cityView.cardImage} alt="Balcony sunset view from the 5th floor studio at Mayan 2" loading="lazy" />
            <span class="prop-badge badge-sold">{cityView.badge}</span>
          </div>
          <div class="prop-body">
            <div class="prop-meta">
              <span>{cityView.floor}</span><span class="dot">·</span><span>{cityView.view}</span>
            </div>
            <h3 class="prop-title">{cityView.title}</h3>
            <p class="prop-hook">{cityView.hook}</p>
            <div class="prop-cta">
              <span>View Studio</span>
              <Icon name="arrow" size={16} />
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section location-section">
    <div class="container">
      <div class="location-grid">
        <div class="location-text fade-in">
          <span class="eyebrow">Location</span>
          <h2>At the heart of Yas Island.</h2>
          <div class="gold-divider"></div>
          <p>
            Mayan is Aldar's waterfront community on Yas Island — an enclave of low-rise residences set between the Arabian Gulf and Yas Links Golf Course. Minutes from Yas Mall, Ferrari World, Yas Waterworld, and Zayed International Airport, with downtown Abu Dhabi and Dubai both within easy reach.
          </p>
          <div class="distance-list">
            {distances.map((d) => (
              <div class="distance-row">
                <span class="distance-place">{d.place}</span>
                <span class="distance-dots"></span>
                <span class="distance-time">{d.time}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="location-photo fade-in">
          <img src="/images/amenities/beach-water.jpg" alt="Beach with Mayan building behind" loading="lazy" />
          <div class="location-photo-cap">Mayan 2 · Beachfront</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-inner fade-in">
        <span class="eyebrow gold-on-dark">Contact</span>
        <h2 class="white-h">Schedule a private viewing.</h2>
        <div class="gold-divider center"></div>
        <p class="muted-on-dark">
          Reach out directly to the owner for viewings, details, or any questions.
        </p>
        <div class="contact-actions">
          <a href={whatsappURL} target="_blank" rel="noopener" class="btn btn-gold">
            <Icon name="whatsapp" size={18} /> WhatsApp {whatsappDisplay}
          </a>
          <a href="/contact" class="btn btn-outline-light">Send a Message</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    color: var(--white);
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
    animation: kenburns 22s ease-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1.0) translate(0,0); }
    to { transform: scale(1.10) translate(-1%, -2%); }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,25,59,0.45) 0%, rgba(17,25,59,0.2) 40%, rgba(17,25,59,0.7) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 8rem;
    padding-bottom: 6rem;
    max-width: 880px;
  }
  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 6.5vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: rgba(255,255,255,0.92);
    max-width: 720px;
    line-height: 1.5;
  }

  /* PORTFOLIO */
  .portfolio { background: var(--ivory); }
  .portfolio-head {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 1180px;
    margin: 0 auto;
  }
  @media (max-width: 880px) {
    .portfolio-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
  .prop-card {
    background: var(--white);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    transition: transform 500ms ease, box-shadow 500ms ease;
    color: var(--navy);
  }
  .prop-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .prop-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .prop-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms ease;
  }
  .prop-card:hover .prop-image img { transform: scale(1.04); }
  .prop-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.45rem 0.9rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .badge-available {
    background: var(--gold);
    color: var(--white);
  }
  .badge-sold {
    background: rgba(13, 13, 13, 0.85);
    color: var(--white);
    backdrop-filter: blur(8px);
  }
  .prop-body {
    padding: 2rem 1.85rem 2.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .prop-meta {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .prop-meta .dot { color: var(--gold); }
  .prop-title {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    color: var(--navy);
    margin: 0;
  }
  .prop-hook {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .prop-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.35rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--gray-warm);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .prop-cta :global(svg) { transition: transform 300ms ease; }
  .prop-card:hover .prop-cta :global(svg) { transform: translateX(6px); }

  /* LOCATION */
  .location-section { background: var(--white); }
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 900px) { .location-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .location-text p { font-size: 1.02rem; line-height: 1.8; margin-bottom: 2rem; }
  .distance-list { display: flex; flex-direction: column; gap: 0.85rem; }
  .distance-row { display: flex; align-items: baseline; gap: 0.75rem; font-size: 0.95rem; }
  .distance-place { color: var(--navy); font-weight: 500; }
  .distance-dots { flex: 1; border-bottom: 1px dotted var(--gray-warm); transform: translateY(-4px); }
  .distance-time { color: var(--gold); font-weight: 600; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .location-photo { position: relative; }
  .location-photo img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .location-photo-cap {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--white);
    padding: 0.6rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* CONTACT */
  .contact-section { background: var(--navy); color: var(--white); }
  .contact-inner { text-align: center; max-width: 640px; margin: 0 auto; }
  .white-h { color: var(--white); }
  .muted-on-dark { color: rgba(255,255,255,0.72); margin-bottom: 2rem; line-height: 1.7; }
  .gold-on-dark { color: var(--gold-light); }
  .contact-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
