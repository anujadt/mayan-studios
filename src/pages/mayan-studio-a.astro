---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Gallery from '../components/Gallery.astro';
import { studioAGallery } from '../data/properties';

const interior = [
  { icon: 'bed', text: 'Comfortable sleeping area with built-in wardrobe' },
  { icon: 'area', text: 'Ample open-plan living and dining' },
  { icon: 'check', text: 'Kitchen with built-in cabinets' },
  { icon: 'bath', text: 'Well-maintained bathroom with bathtub' },
  { icon: 'view', text: 'Spacious and private balcony' },
  { icon: 'check', text: 'Centralised air conditioning' },
];

const building = [
  { icon: 'concierge', text: '24/7 concierge and security' },
  { icon: 'gym', text: 'Fully-equipped gym' },
  { icon: 'pool', text: 'Swimming pools and children\'s pools' },
  { icon: 'garden', text: 'Indoor and outdoor children\'s playgrounds' },
  { icon: 'bbq', text: 'Barbecue areas' },
  { icon: 'beach', text: 'Direct beach access' },
  { icon: 'parking', text: 'Underground parking' },
  { icon: 'sauna', text: 'Sauna and steam rooms' },
];

const nearby = [
  { place: 'Beach & golf course', time: '1 min' },
  { place: 'Yas Bay restaurants', time: '3 min' },
  { place: 'Yas Marina Circuit (F1)', time: '7 min' },
  { place: 'Yas Mall (shopping & cinemas)', time: '9 min' },
  { place: 'Zayed International Airport', time: '10 min' },
  { place: 'Dubai', time: '50 min' },
];

const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Apartment',
  name: 'Studio Apartment at Mayan 2 — 5th Floor',
  description: 'A studio residence at Mayan 2, Yas Island, Abu Dhabi with private balcony, built-in wardrobe, full bathroom and direct access to resort-grade amenities.',
  numberOfRooms: 1,
  floorSize: { '@type': 'QuantitativeValue', value: 550, unitCode: 'FTK' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mayan 2, Yas Island',
    addressLocality: 'Abu Dhabi',
    addressCountry: 'AE',
  },
  amenityFeature: building.map((b) => ({ '@type': 'LocationFeatureSpecification', name: b.text })),
};
---
<Layout
  title="Luxurious Studio · Mayan 2 · 5th Floor | Vacant Now"
  description="HOT DEAL — vacant studio at Mayan 2, Yas Island, Abu Dhabi. 5th floor, 550 sqft, private balcony, built-in wardrobe, full amenities, direct beach access."
  ogImage="/images/studio-a/01-balcony-sunset.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(listingSchema)} />

  <!-- Top hero with title overlay -->
  <section class="listing-hero">
    <div class="hero-image" style="background-image: url('/images/studio-a/01-balcony-sunset.webp')"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <a href="/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Back to Portfolio</span>
      </a>
      <div class="status-pill">
        <span class="dot"></span>
        <span>Vacant · Available Now</span>
      </div>
      <h1>Luxurious Studio in Mayan 2</h1>
      <div class="hero-sub">5th Floor · Yas Island · Abu Dhabi</div>
    </div>
  </section>

  <!-- Specs bar -->
  <section class="specs">
    <div class="container specs-inner">
      <div class="spec"><Icon name="bed" size={20} /><div><span class="spec-num">Studio</span><span class="spec-label">Layout</span></div></div>
      <div class="spec"><Icon name="bath" size={20} /><div><span class="spec-num">1 Bath</span><span class="spec-label">With Bathtub</span></div></div>
      <div class="spec"><Icon name="area" size={20} /><div><span class="spec-num">550 sqft</span><span class="spec-label">Floor Area</span></div></div>
      <div class="spec"><Icon name="floor" size={20} /><div><span class="spec-num">5th Floor</span><span class="spec-label">Mayan 2</span></div></div>
      <div class="spec"><Icon name="vacant" size={20} /><div><span class="spec-num">Vacant</span><span class="spec-label">Move-in Ready</span></div></div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="container-narrow gallery-wrap">
    <Gallery images={studioAGallery} />
  </section>

  <!-- Description -->
  <section class="section description-section">
    <div class="container-narrow">
      <div class="fade-in">
        <span class="eyebrow">The Residence</span>
        <h2>Great Community View · Vacant Now</h2>
        <div class="gold-divider"></div>
        <div class="prose">
          <p class="lead">
            Located in the heart of Yas Island — moments from Ferrari World, Yas Marina Circuit, and Yas Waterworld — this studio at Mayan 2 presents a refined lifestyle in one of Abu Dhabi's most sought-after destinations.
          </p>
          <p>
            Designed for those who value comfort, convenience, and elegance, the residence offers a sophisticated living space complemented by the dynamic energy of island life — a well-connected address for individuals seeking an upscale, low-maintenance home in Abu Dhabi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section features-section">
    <div class="container">
      <div class="features-grid">
        <div class="features-col fade-in">
          <span class="eyebrow">Interior</span>
          <h3>Studio Features</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {interior.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="features-col fade-in">
          <span class="eyebrow">Building</span>
          <h3>Facilities & Amenities</h3>
          <div class="gold-divider"></div>
          <ul class="feature-list">
            {building.map((f) => (
              <li>
                <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Amenity images -->
  <section class="section amenity-images-section">
    <div class="container">
      <div class="amenity-images-grid fade-in">
        <figure>
          <img src="/images/amenities/rooftop-pool.webp" alt="Rooftop pool" loading="lazy" />
          <figcaption>Rooftop pool</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/gym.webp" alt="Building gym" loading="lazy" />
          <figcaption>Fully-equipped gym</figcaption>
        </figure>
        <figure>
          <img src="/images/amenities/kids-splash.jpeg" alt="Children's splash area" loading="lazy" />
          <figcaption>Kids' splash area</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section location-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="eyebrow">Location</span>
        <h2>Yas Island — at the centre of it all.</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="location-grid">
        <div class="location-map fade-in">
          <iframe
            src="https://www.google.com/maps?q=Mayan+2+Yas+Island+Abu+Dhabi&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map of Mayan 2, Yas Island"
            allowfullscreen
          ></iframe>
        </div>
        <div class="nearby-list fade-in">
          <h3>Nearby</h3>
          <div class="gold-divider"></div>
          {nearby.map((n) => (
            <div class="nearby-row">
              <span class="nearby-place">{n.place}</span>
              <span class="nearby-dots"></span>
              <span class="nearby-time">{n.time}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="neighbourhood-grid fade-in">
        <figure>
          <img src="/images/location/al-marasy-marina.jpeg" alt="Al Marasy Marina" loading="lazy" />
          <figcaption>Al Marasy Marina · 3 min</figcaption>
        </figure>
        <figure>
          <img src="/images/location/yas-bay-restaurants.jpeg" alt="Yas Bay restaurants" loading="lazy" />
          <figcaption>Yas Bay restaurants · 3 min</figcaption>
        </figure>
        <figure>
          <img src="/images/location/mayan-exterior.jpeg" alt="Mayan from the sea" loading="lazy" />
          <figcaption>Mayan 2 · waterfront</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-text fade-in">
          <span class="eyebrow gold-on-dark">Inquiries</span>
          <h2 class="white-h">Schedule a Private Viewing</h2>
          <div class="gold-divider"></div>
          <p class="muted-on-dark">
            The studio is vacant and available for immediate move-in. Share a few details below and the owner will follow up personally to arrange a private viewing.
          </p>
          <div class="contact-meta">
            <div>
              <h5>Email</h5>
              <a href="mailto:hello@mayanstudios.example">hello@mayanstudios.example</a>
            </div>
            <div>
              <h5>WhatsApp</h5>
              <a href="https://wa.me/971500000000?text=Hi%2C%20I%27m%20interested%20in%20the%205th%20Floor%20Studio%20at%20Mayan%202." target="_blank" rel="noopener">+971 50 000 0000</a>
            </div>
          </div>
        </div>
        <div class="contact-form-wrap fade-in">
          <InquiryForm property="Studio Apartment · Mayan 2 · 5th Floor" variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky mobile CTA -->
  <div class="sticky-cta">
    <div class="sticky-text">
      <div class="sticky-title">Mayan 2 · 5F</div>
      <div class="sticky-sub">Vacant · Available Now</div>
    </div>
    <a href="#contact" class="btn btn-gold sticky-btn">Inquire</a>
  </div>
</Layout>

<style>
  .listing-hero {
    position: relative;
    height: 80vh;
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,25,59,0.35) 0%, rgba(17,25,59,0.15) 35%, rgba(17,25,59,0.85) 100%);
  }
  .listing-hero .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 4rem;
    padding-top: 8rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin-bottom: 1.5rem;
  }
  .back-link:hover { color: var(--gold); }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.25);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }
  .status-pill .dot {
    width: 8px;
    height: 8px;
    background: #4ADE80;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(74,222,128,0.25);
  }
  .listing-hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.0;
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: rgba(255,255,255,0.85);
  }

  /* Specs */
  .specs {
    background: var(--white);
    border-bottom: 1px solid var(--gray-warm);
    padding: 2rem 0;
  }
  .specs-inner {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }
  .spec {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--gold);
  }
  .spec > div {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .spec-num {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--navy);
  }
  .spec-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .specs-inner { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 480px) {
    .specs-inner { grid-template-columns: 1fr; }
  }

  .gallery-wrap {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  /* Description */
  .description-section { background: var(--ivory); }
  .prose .lead {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--navy);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  .prose p { font-size: 1.02rem; line-height: 1.85; }

  /* Features */
  .features-section { background: var(--white); }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  @media (max-width: 768px) { .features-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .features-col h3 { margin-bottom: 0.5rem; }
  .feature-list {
    list-style: none;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .feature-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--gray-warm);
    font-size: 0.95rem;
    color: var(--navy);
  }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--ivory);
    color: var(--gold);
    flex-shrink: 0;
  }

  /* Amenity images */
  .amenity-images-section { background: var(--ivory-warm); padding-top: 0; }
  .amenity-images-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 768px) { .amenity-images-grid { grid-template-columns: 1fr; } }
  .amenity-images-grid figure { position: relative; }
  .amenity-images-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .amenity-images-grid figcaption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--white);
    padding: 0.5rem 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* Location */
  .location-section { background: var(--white); }
  .location-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: stretch;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) { .location-grid { grid-template-columns: 1fr; } }
  .location-map iframe {
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
    background: var(--ivory-warm);
  }
  .nearby-list {
    background: var(--ivory);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .nearby-list h3 { margin-bottom: 0.25rem; }
  .nearby-list .gold-divider { margin-bottom: 1rem; }
  .nearby-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
  }
  .nearby-place { color: var(--navy); font-weight: 500; }
  .nearby-dots { flex: 1; border-bottom: 1px dotted var(--gray-warm); transform: translateY(-4px); }
  .nearby-time { color: var(--gold); font-weight: 600; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .neighbourhood-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 768px) { .neighbourhood-grid { grid-template-columns: 1fr; } }
  .neighbourhood-grid figure { position: relative; }
  .neighbourhood-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .neighbourhood-grid figcaption {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(255,255,255,0.95);
    padding: 0.4rem 0.75rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 600;
  }

  /* Contact (matches landing styles) */
  .contact-section { background: var(--navy); color: var(--white); }
  .white-h { color: var(--white); }
  .muted-on-dark { color: rgba(255,255,255,0.7); }
  .gold-on-dark { color: var(--gold-light); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; gap: 3rem; } }
  .contact-text p { font-size: 1.02rem; line-height: 1.8; margin-bottom: 2.5rem; }
  .contact-meta { display: flex; flex-direction: column; gap: 1.5rem; }
  .contact-meta h5 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.35rem;
    font-weight: 600;
  }
  .contact-meta a { color: var(--white); font-size: 1rem; }
  .contact-meta a:hover { color: var(--gold); }

  /* Sticky mobile CTA */
  .sticky-cta {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: none;
    align-items: center;
    justify-content: space-between;
    background: var(--navy);
    color: var(--white);
    padding: 0.75rem 0.75rem 0.75rem 1.25rem;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .sticky-title { font-family: var(--font-serif); font-size: 1rem; font-weight: 600; }
  .sticky-sub { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-light); }
  .sticky-btn {
    min-height: 44px;
    padding: 0.6rem 1.25rem;
    font-size: 0.78rem;
  }
  @media (max-width: 768px) {
    .sticky-cta { display: flex; }
  }
</style>
