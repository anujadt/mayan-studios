---
import Icon from './Icon.astro';
import { whatsappURL } from '../data/properties';
---
<div class="sticky-cta" aria-label="Contact options">
  <div class="sticky-info">
    <div class="sticky-title">Furnished Corner Studio · Mayan 2</div>
    <div class="sticky-sub">★ 8.5 · For sale · AED 148K revenue</div>
  </div>
  <div class="sticky-actions">
    <a href={whatsappURL} target="_blank" rel="noopener" class="cta-wa" aria-label="WhatsApp the owner">
      <Icon name="whatsapp" size={18} />
      <span>WhatsApp</span>
    </a>
    <a href="#contact" class="cta-view">Schedule Viewing</a>
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 60;
    background: var(--navy);
    color: var(--white);
    box-shadow: 0 -8px 24px rgba(11,17,36,0.18);
  }

  /* Mobile: bottom bar */
  @media (max-width: 900px) {
    .sticky-cta {
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 0.75rem 0.6rem 1rem;
      border-top: 1px solid rgba(255,255,255,0.08);
      gap: 0.5rem;
    }
    .sticky-info {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
      min-width: 0;
      flex: 1;
    }
    .sticky-title {
      font-family: var(--font-serif);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--white);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sticky-sub {
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold-light);
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sticky-actions {
      display: flex;
      gap: 0.4rem;
      flex-shrink: 0;
    }
    .cta-wa, .cta-view {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.65rem 0.9rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      min-height: 44px;
    }
    .cta-wa { background: var(--green); color: var(--white); }
    .cta-view { background: var(--gold); color: var(--white); }
    .cta-view { display: none; }
  }

  /* Desktop: floating sidebar (right-side rail) */
  @media (min-width: 901px) {
    .sticky-cta {
      right: 1.25rem;
      bottom: 1.25rem;
      background: var(--white);
      color: var(--navy);
      border: 1px solid var(--gray-warm);
      padding: 1rem 1.1rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      min-width: 240px;
      max-width: 280px;
      box-shadow: var(--shadow-lg);
    }
    .sticky-info { display: flex; flex-direction: column; line-height: 1.2; }
    .sticky-title {
      font-family: var(--font-serif);
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--navy);
    }
    .sticky-sub {
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold);
      margin-top: 3px;
    }
    .sticky-actions { display: flex; flex-direction: column; gap: 0.4rem; }
    .cta-wa, .cta-view {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.65rem 0.9rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .cta-wa { background: var(--green); color: var(--white); }
    .cta-wa:hover { background: #1ebd5b; color: var(--white); }
    .cta-view { background: var(--gold); color: var(--white); }
    .cta-view:hover { background: var(--navy); color: var(--white); }
  }
</style>
