---
import Icon from './Icon.astro';
import { whatsappURL } from '../data/properties';
---
<a class="sticky-wa" href={whatsappURL} target="_blank" rel="noopener" aria-label="WhatsApp the owner">
  <Icon name="whatsapp" size={22} />
  <span class="sticky-label">WhatsApp the Owner</span>
</a>

<style>
  .sticky-wa {
    position: fixed;
    z-index: 60;
    right: 1.25rem;
    bottom: 1.25rem;
    background: var(--green);
    color: var(--white);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.15rem 0.85rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 12px 32px rgba(11,17,36,0.25);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .sticky-wa:hover {
    transform: translateY(-2px);
    color: var(--white);
    box-shadow: 0 18px 40px rgba(11,17,36,0.28);
  }
  @media (max-width: 600px) {
    .sticky-wa {
      right: 1rem;
      bottom: 1rem;
      padding: 0.85rem;
    }
    .sticky-label { display: none; }
  }
</style>
