---
import Icon from './Icon.astro';
import { whatsappURL } from '../data/properties';
---
<section class="quick-contact">
  <div class="container-narrow qc-inner">
    <div class="qc-text fade-in">
      <span class="eyebrow gold-on-dark">Next Step</span>
      <h3 class="white-h">Ready to talk?</h3>
      <p class="muted-on-dark">
        Speak directly with the owner — no agent, no listing fees. Confidential viewings available evenings and weekends.
      </p>
    </div>

    <div class="qc-actions fade-in">
      <div class="qc-buttons">
        <button class="qc-btn primary" data-intent="buy">I Want to Buy</button>
        <button class="qc-btn secondary" data-intent="learn">I Want to Learn More</button>
      </div>

      <form class="qc-form" action="https://formspree.io/f/xpwzgvqr" method="POST" data-qc-form>
        <input type="hidden" name="_subject" value="Quick inquiry · Mayan 2 corner studio" />
        <input type="hidden" name="source" value="quick-contact" />
        <input type="hidden" name="intent" id="qc-intent" value="" />
        <div class="qc-row">
          <input name="name" type="text" placeholder="Your name" required autocomplete="name" />
          <input name="phone" type="tel" placeholder="Phone or WhatsApp" required autocomplete="tel" />
        </div>
        <div class="qc-row qc-row-actions">
          <button type="submit" class="qc-submit">Request a Call</button>
          <a href={whatsappURL} target="_blank" rel="noopener" class="qc-wa">
            <Icon name="whatsapp" size={16} /> WhatsApp instead
          </a>
        </div>
      </form>
      <p class="qc-note">Replies within 24 hours. Private listing — your details stay between you and the owner.</p>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('[data-intent]');
  const intentInput = document.getElementById('qc-intent') as HTMLInputElement | null;
  const form = document.querySelector('[data-qc-form]');
  buttons.forEach((b) => {
    b.addEventListener('click', () => {
      const intent = (b as HTMLElement).dataset.intent || '';
      if (intentInput) intentInput.value = intent;
      buttons.forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      form?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      (form?.querySelector('input[name="name"]') as HTMLElement | null)?.focus();
    });
  });
</script>

<style>
  .quick-contact {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--white);
    padding: 4.5rem 0;
  }
  .qc-inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .qc-inner { grid-template-columns: 1fr; gap: 2rem; }
    .quick-contact { padding: 3.5rem 0; }
  }
  .qc-text h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--white);
    margin-bottom: 0.85rem;
  }
  .qc-text p { color: rgba(255,255,255,0.75); font-size: 1rem; line-height: 1.65; }
  .white-h { color: var(--white); }
  .gold-on-dark { color: var(--gold-light); }
  .muted-on-dark { color: rgba(255,255,255,0.7); }

  .qc-actions {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 1.5rem;
  }
  .qc-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 480px) { .qc-buttons { grid-template-columns: 1fr; } }
  .qc-btn {
    padding: 1rem 1.2rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .qc-btn.primary {
    background: var(--gold);
    color: var(--white);
    border-color: var(--gold);
  }
  .qc-btn.primary:hover, .qc-btn.primary.active {
    background: var(--gold-light);
    border-color: var(--gold-light);
    color: var(--navy);
  }
  .qc-btn.secondary {
    background: transparent;
    color: var(--white);
    border-color: rgba(255,255,255,0.4);
  }
  .qc-btn.secondary:hover, .qc-btn.secondary.active {
    background: var(--white);
    color: var(--navy);
    border-color: var(--white);
  }
  .qc-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .qc-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  @media (max-width: 560px) { .qc-row { grid-template-columns: 1fr; } }
  .qc-row input {
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background: rgba(255,255,255,0.06);
    color: var(--white);
    border: 1px solid rgba(255,255,255,0.18);
  }
  .qc-row input::placeholder { color: rgba(255,255,255,0.45); }
  .qc-row input:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(255,255,255,0.1);
  }
  .qc-row-actions { align-items: center; }
  .qc-submit {
    padding: 0.95rem 1rem;
    background: var(--gold);
    color: var(--white);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 200ms ease;
  }
  .qc-submit:hover { background: var(--gold-light); color: var(--navy); }
  .qc-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.9rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
    background: var(--green);
  }
  .qc-wa:hover { background: #1ebd5b; color: var(--white); }
  .qc-note {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    margin-top: 0.5rem;
    line-height: 1.5;
  }
</style>
