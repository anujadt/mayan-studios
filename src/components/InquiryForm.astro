---
export interface Props {
  property?: string;
  variant?: 'light' | 'dark';
  simple?: boolean;
}
const { property = 'Luxury Studios on Yas Island', variant = 'light', simple = false } = Astro.props as Props;

const interestOptions = [
  'Buying',
  'Investment Inquiry',
  'Schedule Viewing',
  'Other',
];
---
<form class={`inquiry-form ${variant}`} data-wa-form data-property={property}>
  <input type="hidden" name="property" value={property} />

  <div class="form-grid">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>
    {!simple && (
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+971 50 000 0000" />
      </div>
    )}
    {!simple && (
      <div class="field">
        <label for="interest">I'm interested in</label>
        <select id="interest" name="interest" required>
          {interestOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
    )}
    {!simple && (
      <div class="field full">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4" placeholder="I'd like to schedule a private viewing..."></textarea>
      </div>
    )}
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-gold">
      {simple ? 'Register Interest' : 'Send Inquiry'}
    </button>
    <a class="whatsapp-link" href={`https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20${encodeURIComponent(property)}.%20Please%20share%20details.`} target="_blank" rel="noopener">
      Prefer WhatsApp →
    </a>
  </div>

  <p class="form-note">Your inquiry is private and reaches the owner directly.</p>
</form>

<script>
  const WA_PHONE = '971547026170';
  document.querySelectorAll<HTMLFormElement>('form[data-wa-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = (data.get('name') as string || '').trim();
      const email = (data.get('email') as string || '').trim();
      const phone = (data.get('phone') as string || '').trim();
      const interest = (data.get('interest') as string || '').trim();
      const message = (data.get('message') as string || '').trim();
      const property = form.dataset.property || 'Mayan Studios';

      const contact = [email, phone].filter(Boolean).join(', ');
      const parts: string[] = [];
      parts.push(`Hi, I'm ${name || 'a prospective buyer'}${contact ? ` (${contact})` : ''}.`);
      parts.push(`I'm interested in ${property}${interest ? ` — ${interest}` : ''}.`);
      if (message) parts.push(message);

      const url = `https://wa.me/${WA_PHONE}?text=${encodeURIComponent(parts.join(' '))}`;
      window.open(url, '_blank', 'noopener');
    });
  });
</script>

<style>
  .inquiry-form { width: 100%; }
  .form-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .whatsapp-link {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    transition: color 200ms ease;
  }
  .inquiry-form.dark .whatsapp-link { color: var(--gold-light); }
  .whatsapp-link:hover { color: var(--navy); }
  .inquiry-form.dark .whatsapp-link:hover { color: var(--white); }
  .form-note {
    font-size: 0.78rem;
    margin-top: 1rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .inquiry-form.dark .form-note { color: rgba(255,255,255,0.55); }
  .inquiry-form.dark .field label { color: var(--gold-light); }
  .inquiry-form.dark .field input,
  .inquiry-form.dark .field textarea,
  .inquiry-form.dark .field select {
    background: rgba(255,255,255,0.06);
    color: var(--white);
    border-color: rgba(255,255,255,0.15);
  }
  .inquiry-form.dark .field input::placeholder,
  .inquiry-form.dark .field textarea::placeholder {
    color: rgba(255,255,255,0.4);
  }
  .inquiry-form.dark .field input:focus,
  .inquiry-form.dark .field textarea:focus,
  .inquiry-form.dark .field select:focus {
    border-color: var(--gold);
    background: rgba(255,255,255,0.1);
  }
  .field select {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background: var(--white);
    color: var(--text);
    border: 1px solid var(--gray-warm);
    border-radius: 2px;
    transition: border-color var(--transition);
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23C69B3C' stroke-width='1.5'%3e%3cpath d='M6 9l6 6 6-6' stroke-linecap='round' stroke-linejoin='round'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.85rem center;
    background-size: 18px;
    padding-right: 2.5rem;
  }
  .inquiry-form.dark .field select {
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23D8B864' stroke-width='1.5'%3e%3cpath d='M6 9l6 6 6-6' stroke-linecap='round' stroke-linejoin='round'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.85rem center;
    background-size: 18px;
  }
  .field select:focus { outline: none; border-color: var(--gold); }
</style>
