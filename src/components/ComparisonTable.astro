---
import { comparison } from '../data/properties';

export interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props as Props;
---
<div class={`comparison ${compact ? 'compact' : ''}`}>
  <div class="comp-grid">
    <!-- 5th Floor card -->
    <article class="comp-card sold">
      <div class="comp-image">
        <img src="/images/studio-5f/balcony-sunset.png" alt="5th floor studio balcony view, no longer available" loading="lazy" />
        <span class="off-ribbon">no longer available</span>
      </div>
      <div class="comp-body">
        <div class="comp-floor">5th Floor · Standard Studio</div>
        <h4 class="comp-title">Unfurnished Studio</h4>
        <ul class="comp-meta">
          <li>Standard layout</li>
          <li>Unfurnished · requires fit-out</li>
          <li>Not on Booking.com</li>
        </ul>
      </div>
    </article>

    <!-- 2nd Floor card -->
    <article class="comp-card available">
      <div class="comp-image">
        <img src="/images/studio-2f/01-bedroom-living.jpg" alt="2nd floor corner studio, fully furnished and available" loading="lazy" />
        <span class="avail-badge">Available</span>
      </div>
      <div class="comp-body">
        <div class="comp-floor">2nd Floor · Corner Unit</div>
        <h4 class="comp-title">Furnished Corner Studio</h4>
        <ul class="comp-meta">
          <li>Corner unit · more natural light</li>
          <li>Fully furnished · move-in ready</li>
          <li>★ 8.5 on Booking.com · AED 148K revenue</li>
        </ul>
        <a href="/studio-corner-2f" class="comp-cta">View the Available Unit →</a>
      </div>
    </article>
  </div>

  {!compact && (
    <div class="comp-table-wrap">
      <table class="comp-table">
        <thead>
          <tr>
            <th></th>
            <th class="th-sold">5th Floor</th>
            <th class="th-avail">2nd Floor (Available)</th>
          </tr>
        </thead>
        <tbody>
          {comparison.map((row) => (
            <tr>
              <th scope="row">{row.feature}</th>
              <td class="td-sold">{row.sold}</td>
              <td class="td-avail">{row.available}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>

<style>
  .comparison { width: 100%; }
  .comp-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  @media (max-width: 768px) {
    .comp-grid { grid-template-columns: 1fr; }
  }
  .comp-card {
    background: var(--white);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--gray-warm);
  }
  .comp-card.available {
    transform: scale(1.02);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gold);
  }
  @media (max-width: 768px) {
    .comp-card.available { transform: none; }
  }
  .comp-card.sold .comp-image img {
    filter: saturate(0.55) brightness(0.95);
  }
  .comp-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .comp-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .off-ribbon {
    position: absolute;
    left: 0;
    bottom: 1rem;
    background: #2D2D2D;
    color: rgba(255,255,255,0.92);
    padding: 0.45rem 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    font-weight: 500;
  }
  .avail-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--gold);
    color: var(--white);
    padding: 0.45rem 0.9rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .comp-body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .comp-floor {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }
  .comp-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--navy);
    margin: 0;
  }
  .comp-meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .comp-meta li::before {
    content: '·';
    color: var(--gold);
    margin-right: 0.5rem;
    font-weight: 700;
  }
  .comp-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.7rem 1.1rem;
    background: var(--gold);
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .comp-cta:hover { background: var(--navy); color: var(--white); }

  /* Table */
  .comp-table-wrap {
    margin-top: 2rem;
    overflow-x: auto;
    border: 1px solid var(--gray-warm);
    background: var(--white);
  }
  .comp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .comp-table th, .comp-table td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--gray-warm);
    vertical-align: top;
  }
  .comp-table thead th {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--ivory);
  }
  .comp-table th.th-avail { color: var(--gold); }
  .comp-table tbody th { font-weight: 600; color: var(--navy); width: 30%; background: var(--ivory); }
  .comp-table .td-sold { color: var(--text-muted); }
  .comp-table .td-avail { color: var(--navy); font-weight: 500; }
  .comp-table tbody tr:last-child th,
  .comp-table tbody tr:last-child td { border-bottom: none; }
</style>
