---
import { whatsappURL, whatsappDisplay } from '../data/properties';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <span class="footer-mark">M</span>
        <div>
          <div class="footer-name">Mayan Studios</div>
          <div class="footer-sub">Yas Island · Abu Dhabi</div>
        </div>
      </div>
      <p class="footer-tag">
        A private portfolio of two studio apartments at Mayan 2, Aldar's waterfront community on Yas Island.
      </p>
    </div>

    <div class="footer-col">
      <h5>Portfolio</h5>
      <a href="/luxury-corner-studio">Luxury Corner Studio</a>
      <a href="/furnished-studio-city-view">Furnished Studio with City View</a>
    </div>

    <div class="footer-col">
      <h5>Contact</h5>
      <a href={whatsappURL} target="_blank" rel="noopener">WhatsApp {whatsappDisplay}</a>
      <a href="/contact">Schedule a viewing</a>
    </div>

    <div class="footer-col">
      <h5>Location</h5>
      <p class="addr">Mayan 2, Yas Island<br/>Abu Dhabi, United Arab Emirates</p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <span>© {year} Mayan Studios</span>
      <span class="muted">Private portfolio · Yas Island, Abu Dhabi</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-deep);
    color: rgba(255,255,255,0.78);
    padding: 5rem 0 0;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }
  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
  }
  .footer-brand { padding-right: 1.5rem; }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .footer-mark {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
  }
  .footer-name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--white);
    line-height: 1.1;
  }
  .footer-sub {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: 4px;
  }
  .footer-tag {
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 360px;
    color: rgba(255,255,255,0.7);
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-col h5 {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .footer-col a {
    font-size: 0.92rem;
    color: rgba(255,255,255,0.78);
  }
  .footer-col a:hover { color: var(--gold); }
  .addr {
    font-size: 0.92rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.7);
  }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1.5rem 0;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .footer-bottom .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-bottom .muted { color: rgba(255,255,255,0.45); }
</style>
