---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <span class="footer-mark">Y</span>
        <div>
          <div class="footer-name">Luxury Studios on Yas Island</div>
          <div class="footer-sub">A private listing · For sale</div>
        </div>
      </div>
      <p class="footer-tag">
        A beautifully furnished corner studio in Aldar's waterfront community on Yas Island, Abu Dhabi — 8.5★ rated on Booking.com.
      </p>
    </div>

    <div class="footer-col">
      <h5>Explore</h5>
      <a href="/">Home</a>
      <a href="/studio-corner-2f">Furnished Corner Studio · 2F</a>
      <a href="https://www.booking.com/Share-RgsjJ6" target="_blank" rel="noopener">View on Booking.com ★ 8.5</a>
    </div>

    <div class="footer-col">
      <h5>Inquiries</h5>
      <a href="https://wa.me/971547026170?text=Hi%2C%20I%27m%20interested%20in%20the%20furnished%20studio%20on%20Yas%20Island." target="_blank" rel="noopener">WhatsApp +971 54 702 6170</a>
      <a href="#contact">Schedule a private viewing</a>
    </div>

    <div class="footer-col">
      <h5>Location</h5>
      <p class="addr">Mayan 2, Yas Island<br/>Abu Dhabi, United Arab Emirates</p>
      <a href="/mayan-2f-brief.html" class="footer-pdf" target="_blank" rel="noopener">Download Property Brief →</a>
    </div>
  </div>

  <div class="footer-disclaimer">
    <div class="container">
      <p>
        This is a private listing. For official property transactions, please work with a RERA/ADREC licensed broker. Information shown — including revenue figures, occupancy and guest ratings — is provided in good faith and available for verification during due diligence. Not affiliated with Aldar Properties or Booking.com.
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <span>© {year} Luxury Studios on Yas Island. All rights reserved.</span>
      <span class="muted">Private listing · Independently offered</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-deep);
    color: rgba(255,255,255,0.78);
    padding: 5rem 0 0;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }
  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
  }
  .footer-brand { padding-right: 1.5rem; }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .footer-mark {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
  }
  .footer-name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--white);
    line-height: 1.1;
  }
  .footer-sub {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: 4px;
  }
  .footer-tag {
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 360px;
    color: rgba(255,255,255,0.7);
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-col h5 {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .footer-col a {
    font-size: 0.92rem;
    color: rgba(255,255,255,0.78);
  }
  .footer-col a:hover { color: var(--gold); }
  .addr {
    font-size: 0.92rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.7);
  }
  .footer-pdf {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    border-bottom: 1px solid var(--gold);
    padding-bottom: 3px;
  }
  .footer-pdf:hover { color: var(--gold-light); }
  .footer-disclaimer {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1.5rem 0;
    background: rgba(0,0,0,0.18);
  }
  .footer-disclaimer p {
    font-size: 0.76rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
    max-width: 920px;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1.5rem 0;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .footer-bottom .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-bottom .muted { color: rgba(255,255,255,0.45); }
</style>
